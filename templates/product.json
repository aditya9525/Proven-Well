      "blocks": {
        "accordion_Vz8Tkz": {
          "type": "accordion",
          "settings": {
            "title": "Product Description",
            "content": "<p><strong>A Better Way to Cover Gray</strong></p><p></p><p>Forget mixing bowls, brushes, strong-smelling box dyes and constant salon touch-ups.</p><p></p><p>ProvenWell makes covering grays feel as easy as washing your hair. Apply it where you need color, let it develop, then rinse.</p><p></p><p>The result is rich, natural-looking color that helps stubborn grays blend back into the hair around them.</p><p></p><p>No complicated routine. No obvious “just dyed” look.</p><p></p><p>Just hair that looks richer, fresher and more like you again.</p>",
            "open_by_default": false
          }
        },
        "accordion_mNyVTf": {
          "type": "accordion",
          "settings": {
            "title": "Ingredients",
            "content": "<p>Aqua (Water), Argan Oil, Polygonum Multiflorum Extract, Ginseng Extract, Keratin, Ammonia-Free Plant Dye Actives, Glycerin, Fragrance.</p>",
            "open_by_default": false
          }
        },
        "accordion_mXTMPX": {
          "type": "accordion",
          "settings": {
