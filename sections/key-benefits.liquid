{%- comment -%}
  Polar Haircare — Make Hair Coloring Simple & Hassle-Free Section
{%- endcomment -%}

{%- if section.settings.enable_section -%}
  <section class="make-simple-section" id="makeSimpleSection" aria-labelledby="makeSimpleTitle">
    <div class="make-simple-container">
      <!-- Section Heading (Desktop + Mobile Responsive) -->
      <div class="make-simple-header">
        <span class="make-simple-eyebrow">
          {{- section.settings.eyebrow_text | default: 'GET NATURAL, LASTING COLOR IN JUST 10 MINUTES' -}}
        </span>
        <h2 class="make-simple-title-desktop" id="makeSimpleTitle">
          <span class="title-top">{{ section.settings.title_top | default: 'Make Hair Coloring' }}</span>
          <span class="title-main">{{ section.settings.title_main | default: 'SIMPLE & HASSLE-FREE' }}</span>
        </h2>
        <h2 class="make-simple-title-mobile">
          {{ section.settings.mobile_title | default: 'Make hair coloring simple & hassle-free' }}
        </h2>
        <p class="make-simple-subtitle">
          {{ section.settings.subtitle | default: 'Get natural, lasting color in just 10 minutes' }}
        </p>
      </div>

      <!-- Desktop Dark Purple Banner with Overlapping Video Card -->
      <div class="make-simple-banner">
        <!-- Video Thumbnail Card (Desktop & Mobile trigger) -->
        <div class="make-simple-video-wrap">
          <div
            class="make-simple-video-card js-open-simple-video"
            role="button"
            tabindex="0"
            aria-label="Play demonstration video"
          >
            {%- if section.settings.poster_image != blank -%}
              <img
                src="{{ section.settings.poster_image | image_url: width: 1200 }}"
                alt="{{ section.settings.title_top | escape }}"
                class="make-simple-video-poster"
                loading="lazy"
              >
            {%- else -%}
              <img
                src="{{ 'customer_story.jpg' | asset_url }}"
                alt="Make Hair Coloring Simple Video"
                class="make-simple-video-poster"
                loading="lazy"
              >
            {%- endif -%}
            <div class="make-simple-play-btn" aria-hidden="true">
              <svg width="22" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="6 3 20 12 6 21 6 3"></polygon>
              </svg>
            </div>
          </div>
        </div>

        <!-- Desktop 4-Feature Row (inside the banner) -->
