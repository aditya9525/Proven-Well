{%- comment -%}
  Polar Haircare Footer Section
  Includes Brand Bio, Contact Details, Social, Newsletter Subscription, Navigation Columns, Localization Selector, Copyright, and Payment Badges.
{%- endcomment -%}

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    <!-- Main Row: Left Brand/Contact & Right Nav/Newsletter -->
    <div class="footer-main-row">
      <!-- Left Column: Brand Info & Contact (Desktop Frame 17) -->
      <div class="footer-brand-col">
        <div class="footer-brand-logo-wrap">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              loading="lazy"
              class="brand-logo-img"
              style="max-width: {{ section.settings.logo_width | default: 150 }}px;"
            >
          {%- else -%}
            <!-- Desktop ProvenWell Logo -->
            <img
              src="{{ 'provenwellLogo.png' | asset_url }}"
              alt="ProvenWell"
              loading="lazy"
              class="footer-logo-desktop"
              width="141"
              height="49"
            >
            <!-- Mobile Polar Logo -->
            <div class="footer-logo-mobile">
              <svg
                class="footer-logo-svg"
                viewBox="0 0 150 32"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-label="Polar Hair Care"
              >
                <text x="0" y="20" font-family="'Lato', 'Red Hat Display', sans-serif" font-size="22" font-weight="300" letter-spacing="5" fill="#FFFFFF">POLAR</text>
                <text x="2" y="30" font-family="'Lato', 'Red Hat Display', sans-serif" font-size="7" font-weight="400" letter-spacing="4.8" fill="#FFFFFF">HAIR CARE</text>
              </svg>
            </div>
          {%- endif -%}
        </div>

        <p class="footer-about-text">
          {{
            section.settings.about_text
            | default: "At Polar, we prioritize naturally vibrant hair. Our instant dye shampoo covers grays in 10 minutes without the mess, damage, or chemicals of traditional dyes. When you choose Polar, you're committing to effortless confidence."
          }}
        </p>

        <ul class="footer-contact-list">
          <li class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M22 6L12 13L2 6"></path>
              </svg>
            </span>
            <a
              href="mailto:{{ section.settings.email | default: 'customers@polarhaircare.com' }}"
              class="footer-contact-link"
            >
              {{ section.settings.email | default: 'customers@polarhaircare.com' }}
            </a>
          </li>

          <li class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <a href="tel:{{ section.settings.phone_link | default: '+18334240123' }}" class="footer-contact-link">
              {{ section.settings.phone | default: '+1 (833) 424-0123' }}
            </a>
          </li>
        </ul>

        <p class="footer-service-hours">
          {{
            section.settings.service_hours
            | default: 'Our customer service team is available 24/7, Monday through Saturday.'
          }}
        </p>

        <div class="footer-social-wrap">
          <a
            href="{{ section.settings.instagram_url | default: 'https://instagram.com/polarhaircare' }}"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label="Follow us on Instagram"
          >
            <span class="footer-contact-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </span>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Navigation & Newsletter (Desktop Container 552.13px) -->
      <div class="footer-right-col">
        <!-- Navigation Links -->
        <div class="footer-nav-cols">
          <!-- Information Links -->
          <div class="footer-nav-col">
            <h3 class="footer-block-heading">{{ section.settings.menu_1_heading | default: 'Information' }}</h3>
            <ul class="footer-nav-list">
              {%- if section.settings.menu_1 != blank -%}
                {%- for link in linklists[section.settings.menu_1].links -%}
                  <li class="footer-nav-item">
                    <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="footer-nav-item">
                  <a href="/pages/track-order" class="footer-nav-link">Track Your Order</a>
                </li>
                <li class="footer-nav-item">
                  <a href="/pages/returns-exchanges" class="footer-nav-link">Returns &amp; Exchanges</a>
                </li>
                <li class="footer-nav-item">
                  <a href="/pages/shipping-information" class="footer-nav-link">Shipping Information</a>
                </li>
                <li class="footer-nav-item">
                  <a href="/pages/help-center" class="footer-nav-link">Help Center / FAQ</a>
                </li>
                <li class="footer-nav-item"><a href="/pages/contact" class="footer-nav-link">Contact Us</a></li>
              {%- endif -%}
            </ul>
          </div>

          <!-- More Information Links -->
          <div class="footer-nav-col">
            <h3 class="footer-block-heading">{{ section.settings.menu_2_heading | default: 'More Information' }}</h3>
            <ul class="footer-nav-list">
              {%- if section.settings.menu_2 != blank -%}
                {%- for link in linklists[section.settings.menu_2].links -%}
                  <li class="footer-nav-item">
                    <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="footer-nav-item">
                  <a href="/policies/terms-of-service" class="footer-nav-link">Terms of Service</a>
                </li>
                <li class="footer-nav-item">
                  <a href="/policies/privacy-policy" class="footer-nav-link">Privacy Policy</a>
                </li>
                <li class="footer-nav-item"><a href="/blogs/news" class="footer-nav-link">Blog</a></li>
              {%- endif -%}
            </ul>
          </div>
        </div>

        <!-- Newsletter Column -->
        <div class="footer-newsletter-col">
          <h3 class="footer-block-heading">
            {{ section.settings.newsletter_heading | default: 'Subscribe to our emails' }}
          </h3>
          {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              class="footer-newsletter-input"
              value="{{ form.email }}"
              placeholder="Email"
              aria-label="Email address"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
            >
            <button type="submit" class="footer-newsletter-btn" aria-label="Subscribe">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>

            <p class="footer-newsletter-msg" role="status" aria-live="polite" hidden></p>
          {%- endform -%}
        </div>
      </div>
    </div>

    <!-- Mobile Divider Line -->
    <div class="footer-divider-mobile" aria-hidden="true"></div>

    <!-- Bottom Block: Localization, Copyright & Payment Badges -->
    <div class="footer-bottom-block">
      <!-- Desktop Country/Currency Selector Button -->
      <div class="footer-desktop-localization">
        <div class="footer-localization-box" role="button" tabindex="0" aria-label="Country and currency selector">
          <span>India | INR &#8377;</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>

      <!-- Desktop Copyright Notice -->
      <p class="footer-desktop-copyright">Copyright &copy; {{ 'now' | date: '%Y' }} Polar Haircare</p>

      <!-- Payment Method Badges (13 Badges matching Figma) -->
