          <svg viewBox="0 0 42 27" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="42" height="26.5" rx="3" fill="#232323"/>
            <circle cx="16" cy="13.25" r="6.5" fill="#EB001B"/>
