        <!-- 11. PayPal -->
        <li class="footer-payment-item" title="PayPal">
          <svg viewBox="0 0 42 27" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="42" height="26.5" rx="3" fill="#FFFFFF"/>
            <path d="M15.5 8h4.5c2.3 0 3.8 1.2 3.5 3.2-.4 2.2-2.1 3.5-4.4 3.5h-1.8l-1 5.3h-2.5l2.7-12z" fill="#003087"/>
