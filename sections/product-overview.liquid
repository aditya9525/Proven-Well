{%- comment -%}
  Polar Haircare — 04 Product / Solution Overview Section
  Features product callout visual card, eyebrow, heading, description, 6 checkmark benefits,
  4-column spec table, shade swatch selectors, and primary & secondary CTA buttons.
{%- endcomment -%}

{%- liquid
  assign overview_product = section.settings.product | default: product
  if overview_product == blank and all_products['instant-dye-shampoo'] != blank
    assign overview_product = all_products['instant-dye-shampoo']
  endif
  if overview_product == blank and collections.all.products.first != blank
    assign overview_product = collections.all.products.first
  endif

  # Target 1 Bottle Variant
  assign v1 = null
  if overview_product != blank and overview_product.variants.size > 0
    for variant in overview_product.variants
      assign v_title_lower = variant.title | downcase
      if v_title_lower contains '1'
        assign v1 = variant
        break
      endif
    endfor
    if v1 == null
      assign v1 = overview_product.selected_or_first_available_variant | default: overview_product.variants[0]
    endif
  endif

  # Dynamic Price for 1 Bottle
  if v1 != blank and v1.price > 0
    assign v1_price = v1.price
  else
    assign v1_price = overview_product.price | default: 350000
  endif

  assign formatted_v1_price = v1_price | money_without_trailing_zeros | remove: '.00'

  # Dynamic Color Category Metafields
  assign cat_colors = overview_product.metafields.custom.colors.value
  if cat_colors == blank
    assign cat_colors = overview_product.metafields.shopify['color-pattern'].value
  endif
  if cat_colors == blank
    assign cat_colors = overview_product.metafields.shopify.color.value
  endif
  if cat_colors == blank
    assign cat_colors = overview_product.metafields.shopify['hair-color'].value
  endif
  if cat_colors == blank
    assign cat_colors = overview_product.metafields.shopify.hair_color.value
  endif
  if cat_colors == blank
    assign cat_colors = overview_product.metafields.custom.color.value
  endif
  if cat_colors == blank
    assign cat_colors = overview_product.metafields.custom.colors.value
  endif
  if cat_colors == blank and overview_product.metafields.shopify['color-pattern'] != blank
    assign cat_colors = overview_product.metafields.shopify['color-pattern']
  endif
  if cat_colors == blank and overview_product.metafields.shopify.color != blank
    assign cat_colors = overview_product.metafields.shopify.color
  endif

  if cat_colors == blank
    for option in overview_product.options_with_values
      assign opt_name_lower = option.name | downcase
      if opt_name_lower contains 'color' or opt_name_lower contains 'shade'
        assign cat_colors = option.values
        break
      endif
    endfor
  endif

  # Determine Default Selected Color and Dynamic Shades List
  assign default_first_color = ''
  assign dynamic_shades_list = ''
  if cat_colors != blank
    for item in cat_colors
      assign c_label = item.label.value | default: item.label | default: item.name | default: item.value | default: item | strip
      assign c_handle_test = c_label | handleize
      if forloop.first
        assign dynamic_shades_list = c_label
        if default_first_color == ''
          assign default_first_color = c_label
        endif
      else
        assign dynamic_shades_list = dynamic_shades_list | append: ' · ' | append: c_label
      endif
      if c_handle_test contains 'dark-brown' or c_handle_test contains 'dark'
        assign default_first_color = c_label
      endif
    endfor
  else
    assign default_first_color = 'Dark Brown'
    assign dynamic_shades_list = 'Black · Dark · Med. Brown'
  endif

  # Dynamic Primary Button Text
  assign raw_btn_text = section.settings.btn_1_text
  if raw_btn_text == blank or raw_btn_text contains '3,500' or raw_btn_text contains '3500'
    assign btn_display_text = 'Add to Cart — ' | append: formatted_v1_price
  elsif raw_btn_text contains '[price]'
    assign btn_display_text = raw_btn_text | replace: '[price]', formatted_v1_price
  else
    assign btn_display_text = raw_btn_text
  endif
-%}

<section class="product-overview-section" id="productOverview-{{ section.id }}" aria-label="Product Solution Overview">
  <div class="product-overview-container">
    <!-- Left Column: Product Feature Callouts Visual Card -->
    <div class="product-overview-visual-col">
      <div class="product-overview-card">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1120
            | image_tag: class: 'product-overview-card-img', loading: 'lazy', alt: section.settings.heading
            | default: 'Polar Instant Dye Shampoo Feature Callouts'
          }}
        {%- elsif overview_product.featured_image != blank -%}
          {{
            overview_product.featured_image
            | image_url: width: 1120
            | image_tag: class: 'product-overview-card-img', loading: 'lazy', alt: overview_product.title
            | escape
          }}
        {%- else -%}
          <img
            src="{{ 'product-feature-callout.png' | asset_url }}"
            alt="Polar Instant Dye Shampoo - Product Features and 840,000+ Happy Customers"
            class="product-overview-card-img"
            loading="lazy"
            width="560"
            height="560"
          >
        {%- endif -%}
      </div>
    </div>

    <!-- Right Column: Product Copy, Checklist, Specs, Swatches & CTAs -->
    <div class="product-overview-copy-col">
      <!-- Eyebrow -->
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-overview-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <!-- Main Headline -->
      <h2 class="product-overview-title">
        {{ section.settings.heading | default: 'Instant Dye Shampoo — one bottle, 15 full applications.' }}
      </h2>

      <!-- Description Body -->
      <p class="product-overview-desc">
        {{
          section.settings.description
          | default: "A color-depositing shampoo powered by botanicals like Ganoderma (reishi), black sesame, ginseng and fo-ti. Apply to dry hair, wait 10 minutes, rinse — that's it."
        }}
      </p>

      <!-- Feature Checklist (6 items) -->
      <ul class="product-overview-checklist">
        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">
            {{- section.settings.feature_1 | default: 'Full gray coverage' -}}
          </span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">
            {{- section.settings.feature_2 | default: 'Results in just 10 minutes' -}}
          </span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">
            {{- section.settings.feature_3 | default: 'No stains, gloves or mixing' -}}
          </span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">
            {{- section.settings.feature_4 | default: 'Gentle on scalp, ammonia-free' -}}
          </span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">
            {{- section.settings.feature_5 | default: 'Color lasts 4–6 weeks' -}}
          </span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">
            {{- section.settings.feature_6 | default: 'Works on hair and beards' -}}
          </span>
        </li>
      </ul>

      <!-- Spec Table (4 columns) -->
      <div class="product-overview-spec-table">
        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_1_label | default: 'SIZE' }}</span>
          <span class="product-overview-spec-val">
            {{- section.settings.spec_1_val | default: '200 ml / 6.76 fl oz' -}}
          </span>
        </div>

        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">
            {{- section.settings.spec_2_label | default: 'USES / BOTTLE' -}}
          </span>
          <span class="product-overview-spec-val">{{ section.settings.spec_2_val | default: '15' }}</span>
        </div>

        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_3_label | default: 'SHADES' }}</span>
          <span class="product-overview-spec-val">
            {%- if section.settings.spec_3_val != blank
              and section.settings.spec_3_val != 'Black · Dark · Med. Brown'
            -%}
              {{ section.settings.spec_3_val }}
            {%- elsif dynamic_shades_list != blank -%}
              {{ dynamic_shades_list }}
            {%- else -%}
              {{ section.settings.spec_3_val | default: 'Black · Dark · Med. Brown' }}
            {%- endif -%}
          </span>
        </div>

        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_4_label | default: 'FORMULA' }}</span>
          <span class="product-overview-spec-val">{{ section.settings.spec_4_val | default: 'Ammonia-free' }}</span>
        </div>
      </div>

      <!-- Shade Swatches (Dynamic Category Metafield & Swatches) -->
      <div class="product-overview-shades-wrapper">
        <p class="product-overview-shades-heading">
          {{ section.settings.shades_heading | default: 'Choose your shade' }}
        </p>
        <div class="product-overview-swatches" role="radiogroup" aria-label="Select Hair Shade">
          {%- if cat_colors != blank -%}
            {%- for item in cat_colors -%}
              {%- liquid
                assign c_name = item.label.value | default: item.label | default: item.name | default: item.value | default: item | strip
                assign c_handle = c_name | handleize
                assign c_hex = item.color | default: item.hex | default: ''
                assign c_image = item.swatch.value | default: item.image.value | default: item.image
                assign is_active = false
                if c_name == default_first_color
                  assign is_active = true
                endif
              -%}
              <button
                type="button"
                class="product-swatch-btn{% if is_active %} is-active{% endif %}"
                role="radio"
                aria-checked="{% if is_active %}true{% else %}false{% endif %}"
                aria-label="Shade {{ c_name | escape }}"
                data-shade="{{ c_handle }}"
                data-color-name="{{ c_name | escape }}"
              >
                <span class="product-swatch-thumb-wrap">
                  {%- if c_image != blank -%}
                    <img
                      src="{{ c_image | image_url: width: 148 }}"
                      alt="{{ c_name | escape }} Shade Swatch"
                      class="product-swatch-img"
                      width="74"
                      height="74"
                      loading="lazy"
                    >
                  {%- elsif c_handle contains 'dark-brown' or c_handle contains 'dark' -%}
                    <img
                      src="{{ 'swatch-dark-brown.png' | asset_url }}"
                      alt="{{ c_name | escape }} Shade Swatch"
                      class="product-swatch-img"
                      width="74"
                      height="74"
                      loading="lazy"
                    >
                  {%- elsif c_handle contains 'medium-brown' or c_handle contains 'medium' -%}
                    <img
                      src="{{ 'swatch-medium-brown.png' | asset_url }}"
                      alt="{{ c_name | escape }} Shade Swatch"
                      class="product-swatch-img"
                      width="74"
                      height="74"
                      loading="lazy"
                    >
                  {%- elsif c_handle contains 'black' -%}
                    <img
                      src="{{ 'swatch-black.png' | asset_url }}"
                      alt="{{ c_name | escape }} Shade Swatch"
                      class="product-swatch-img"
                      width="74"
                      height="74"
                      loading="lazy"
                    >
                  {%- elsif c_hex != blank -%}
                    <span
                      class="swatch-hex-circle"
                      style="background-color: {{ c_hex }}; width: 100%; height: 100%; display: block; border-radius: 6px;"
                    ></span>
                  {%- else -%}
                    <img
                      src="{{ 'swatch-dark-brown.png' | asset_url }}"
                      alt="{{ c_name | escape }} Shade Swatch"
                      class="product-swatch-img"
                      width="74"
                      height="74"
                      loading="lazy"
                    >
                  {%- endif -%}
                </span>
                <span class="product-swatch-title">{{ c_name }}</span>
              </button>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Category Swatches matching store configuration -->
            <button
              type="button"
              class="product-swatch-btn is-active"
              role="radio"
              aria-checked="true"
              aria-label="Shade Dark Brown"
              data-shade="dark-brown"
              data-color-name="Dark Brown"
            >
              <span class="product-swatch-thumb-wrap">
                <img
                  src="{{ 'swatch-dark-brown.png' | asset_url }}"
                  alt="Dark Brown Shade Swatch"
                  class="product-swatch-img"
                  width="74"
                  height="74"
                  loading="lazy"
                >
              </span>
              <span class="product-swatch-title">Dark Brown</span>
            </button>

            <button
              type="button"
              class="product-swatch-btn"
              role="radio"
              aria-checked="false"
              aria-label="Shade Medium Brown"
              data-shade="medium-brown"
              data-color-name="Medium Brown"
            >
              <span class="product-swatch-thumb-wrap">
                <img
                  src="{{ 'swatch-medium-brown.png' | asset_url }}"
                  alt="Medium Brown Shade Swatch"
                  class="product-swatch-img"
                  width="74"
                  height="74"
                  loading="lazy"
                >
              </span>
              <span class="product-swatch-title">Medium Brown</span>
            </button>

            <button
              type="button"
              class="product-swatch-btn"
              role="radio"
              aria-checked="false"
              aria-label="Shade Black"
              data-shade="black"
              data-color-name="Black"
            >
              <span class="product-swatch-thumb-wrap">
                <img
                  src="{{ 'swatch-black.png' | asset_url }}"
                  alt="Black Shade Swatch"
                  class="product-swatch-img"
                  width="74"
                  height="74"
                  loading="lazy"
                >
              </span>
              <span class="product-swatch-title">Black</span>
            </button>
          {%- endif -%}
        </div>
      </div>

      <!-- CTAs Row (Dynamic 1 Bottle Price & Add to Cart) -->
      <div class="product-overview-ctas">
        <button
          type="button"
          class="product-overview-btn-primary product-overview-add-cart-btn"
          data-variant-id="{{ v1.id }}"
          data-selected-color="{{ default_first_color }}"
          aria-label="{{ btn_display_text | escape }}"
        >
          <span class="product-overview-btn-text">{{ btn_display_text }}</span>
        </button>

        <a href="{{ section.settings.btn_2_link | default: '#shade-guide' }}" class="product-overview-btn-secondary">
          {{ section.settings.btn_2_text | default: 'Find Your Shade' }}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionEl =
      document.getElementById('productOverview-{{ section.id }}') ||
      document.querySelector('.product-overview-section');
    if (!sectionEl) return;

    var swatchBtns = sectionEl.querySelectorAll('.product-swatch-btn');
    var addBtn = sectionEl.querySelector('.product-overview-add-cart-btn');

    swatchBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        swatchBtns.forEach(function (b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-checked', 'true');

        var colorName = btn.getAttribute('data-color-name');
        if (addBtn && colorName) {
          addBtn.setAttribute('data-selected-color', colorName);
        }
      });
    });

    if (addBtn) {
      addBtn.addEventListener('click', async function (e) {
        e.preventDefault();
        var variantId = addBtn.getAttribute('data-variant-id');
        var selectedColor = addBtn.getAttribute('data-selected-color');
        var btnTextEl = addBtn.querySelector('.product-overview-btn-text');
        var originalText = btnTextEl ? btnTextEl.textContent : addBtn.textContent;

        if (!variantId) {
          window.location.href = '/products/instant-dye-shampoo';
          return;
        }

        if (addBtn.disabled) return;
        addBtn.disabled = true;
        if (btnTextEl) btnTextEl.textContent = 'Redirecting...';

        var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

        try {
          // Purana cart clear karo taaki checkout mein sirf yahi item aaye
          await fetch(root + 'cart/clear.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
          });

          var formData = new FormData();
          formData.append('id', variantId);
          formData.append('quantity', '1');
          if (selectedColor) {
            formData.append('properties[Color]', selectedColor);
          }

          var res = await fetch(root + 'cart/add.js', {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              Accept: 'application/json',
            },
            body: formData,
          });

          var data = await res.json();
          if (!res.ok || (data.status && data.status >= 400)) {
            throw new Error(data.description || data.message || 'Unable to add to cart');
          }

          // Direct checkout
          window.location.href = root + 'checkout';
        } catch (error) {
          console.error('Buy now error:', error);
          // Fallback: permalink (color property nahi jayegi, par checkout khulega)
          window.location.href = root + 'cart/' + encodeURIComponent(variantId) + ':1';
          addBtn.disabled = false;
          if (btnTextEl) btnTextEl.textContent = originalText;
        }
      });
    }
  })();
</script>

