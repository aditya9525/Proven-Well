        assign v2 = product.variants[1]
        assign v3 = product.variants[2]

        assign v1_price = v1.price | default: 350000
        assign v1_compare = v1.compare_at_price | default: 490000
        assign v1_save = 29
        if v1_compare != blank and v1_compare > v1_price
          assign v1_save = v1_compare | minus: v1_price | times: 100.0 | divided_by: v1_compare | round
        endif

        assign v2_price = v2.price | default: 295000
        assign v2_compare = v2.compare_at_price | default: 490000
        assign v2_save = 40
        if v2_compare != blank and v2_compare > v2_price
          assign v2_save = v2_compare | minus: v2_price | times: 100.0 | divided_by: v2_compare | round
        endif

        assign v3_price = v3.price | default: 233300
        assign v3_compare = v3.compare_at_price | default: 490000
        assign v3_save = 52
        if v3_compare != blank and v3_compare > v3_price
          assign v3_save = v3_compare | minus: v3_price | times: 100.0 | divided_by: v3_compare | round
        endif
