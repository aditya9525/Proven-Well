    {%- liquid
      assign bundle_product = section.settings.product | default: product
      if bundle_product == blank and all_products['instant-dye-shampoo'] != blank
        assign bundle_product = all_products['instant-dye-shampoo']
      endif
      if bundle_product == blank and collections.all.products.first != blank
        assign bundle_product = collections.all.products.first
      endif

      assign v1 = nil
      assign v2 = nil
      assign v3 = nil

      if bundle_product != blank and bundle_product.variants.size > 0
        for variant in bundle_product.variants
          assign v_title_lower = variant.title | downcase
          if v1 == nil and v_title_lower contains '1'
            assign v1 = variant
          elsif v2 == nil and v_title_lower contains '2'
            assign v2 = variant
          elsif v3 == nil and v_title_lower contains '3'
            assign v3 = variant
          endif
        endfor

        if v1 == nil
          assign v1 = bundle_product.selected_or_first_available_variant | default: bundle_product.variants[0]
        endif
        if v2 == nil
          assign v2 = bundle_product.variants[1] | default: v1
        endif
        if v3 == nil
          assign v3 = bundle_product.variants[2] | default: v2
        endif
      endif

      # --- Variant 1 Calculations (1 Bottle) ---
      # In Shopify, price comes per variant
      if section.settings.bundle_1_price != blank
        assign v1_total = section.settings.bundle_1_price | times: 100
      elsif v1 != blank and v1.price > 0
        assign v1_total = v1.price
      else
        assign v1_total = bundle_product.price | default: 350000
      endif
      # Per-bottle price is identical to total for 1 bottle
      assign v1_price_per_bottle = v1_total

      # Compare-at price for 1 Bottle (matching main-product.liquid)
      assign v1_compare_total = v1.compare_at_price | default: bundle_product.compare_at_price | default: 490000
      if v1_compare_total == blank or v1_compare_total <= v1_total
        assign v1_compare_total = 490000
      endif
      if v1_compare_total <= v1_total
        assign v1_compare_total = v1_total | times: 1.4 | round
      endif
      assign v1_compare_per_bottle = v1_compare_total

      # Saving percentage for 1 Bottle (matching main-product.liquid)
      assign v1_save = 29
      if v1_compare_total > v1_total
        assign v1_save = v1_compare_total | minus: v1_total | times: 100.0 | divided_by: v1_compare_total | round
      endif
      assign v1_add_qty = 1

      # --- Variant 2 Calculations (2 Bottles) ---
      # In Shopify, price comes per variant (total bundle price for 2 bottles)
      if section.settings.bundle_2_price != blank
        assign v2_total = section.settings.bundle_2_price | times: 100
      elsif v2 != blank and v2.price > 0 and v2.id != v1.id
        assign v2_total = v2.price
      else
        # Fallback if no separate 2-bottle variant: 590000
        assign v2_total = 590000
      endif
      # Calculate per-bottle price dynamically from the variant total price (total / 2)
      assign v2_price_per_bottle = v2_total | times: 1.0 | divided_by: 2 | round

      # Compare-at price for 2 Bottles (matching main-product.liquid: 980000 total)
      assign v2_compare_val = v2.compare_at_price
      if v2 == blank or v2.id == v1.id or v2_compare_val == blank or v2_compare_val <= v2_price_per_bottle
        assign v2_compare_val = 980000
      endif

      # Determine if variant compare_at_price is pack total (e.g. 980000) or per-bottle (e.g. 490000)
      if v2_compare_val > v1_compare_per_bottle
        assign v2_compare_total = v2_compare_val
        assign v2_compare_per_bottle = v2_compare_total | times: 1.0 | divided_by: 2 | round
      else
        assign v2_compare_per_bottle = v2_compare_val
        assign v2_compare_total = v2_compare_per_bottle | times: 2
      endif

      if v2_compare_total <= v2_total
        assign v2_compare_total = v2_total | times: 1.4 | round
        assign v2_compare_per_bottle = v2_compare_total | times: 1.0 | divided_by: 2 | round
      endif

      # Saving percentage for 2 Bottles (matching main-product.liquid)
      assign v2_save = 40
      if v2_compare_total > v2_total
        assign v2_save = v2_compare_total | minus: v2_total | times: 100.0 | divided_by: v2_compare_total | round
      endif

      if v2 != blank and v2.id != v1.id
        assign v2_add_qty = 1
      else
        assign v2_add_qty = 2
      endif

      # --- Variant 3 Calculations (3 Bottles) ---
      # In Shopify, price comes per variant (total bundle price for 3 bottles)
      if section.settings.bundle_3_price != blank
        assign v3_total = section.settings.bundle_3_price | times: 100
      elsif v3 != blank and v3.price > 0 and v3.id != v1.id and v3.id != v2.id
        assign v3_total = v3.price
      else
        # Fallback if no separate 3-bottle variant: 699900
        assign v3_total = 699900
      endif
      # Calculate per-bottle price dynamically from the variant total price (total / 3)
      assign v3_price_per_bottle = v3_total | times: 1.0 | divided_by: 3 | round

      # Compare-at price for 3 Bottles (matching main-product.liquid: 1470000 total)
      assign v3_compare_val = v3.compare_at_price
      if v3 == blank or v3.id == v1.id or v3.id == v2.id or v3_compare_val == blank or v3_compare_val <= v3_price_per_bottle
        assign v3_compare_val = 1470000
      endif

      # Determine if variant compare_at_price is pack total (e.g. 1470000) or per-bottle (e.g. 490000)
      if v3_compare_val > v1_compare_per_bottle
        assign v3_compare_total = v3_compare_val
        assign v3_compare_per_bottle = v3_compare_total | times: 1.0 | divided_by: 3 | round
      else
        assign v3_compare_per_bottle = v3_compare_val
        assign v3_compare_total = v3_compare_per_bottle | times: 3
      endif

      if v3_compare_total <= v3_total
        assign v3_compare_total = v3_total | times: 1.4 | round
        assign v3_compare_per_bottle = v3_compare_total | times: 1.0 | divided_by: 3 | round
      endif

      # Saving percentage for 3 Bottles (matching main-product.liquid)
      assign v3_save = 52
      if v3_compare_total > v3_total
        assign v3_save = v3_compare_total | minus: v3_total | times: 100.0 | divided_by: v3_compare_total | round
      endif

      if v3 != blank and v3.id != v1.id and v3.id != v2.id
        assign v3_add_qty = 1
      else
        assign v3_add_qty = 3
      endif

      # Bundle Titles
      assign bundle_1_title = section.settings.bundle_1_title
      if bundle_1_title == blank
        if v1.title != blank and v1.title != 'Default Title'
          assign bundle_1_title = v1.title
        else
          assign bundle_1_title = '1 Bottle'
        endif
      endif

      assign bundle_2_title = section.settings.bundle_2_title
      if bundle_2_title == blank
        if v2.title != blank and v2.title != 'Default Title' and v2.title != v1.title
          assign bundle_2_title = v2.title
        else
          assign bundle_2_title = '2 Bottles'
        endif
      endif

      assign bundle_3_title = section.settings.bundle_3_title
      if bundle_3_title == blank
        if v3.title != blank and v3.title != 'Default Title' and v3.title != v1.title and v3.title != v2.title
          assign bundle_3_title = v3.title
        else
          assign bundle_3_title = '3 Bottles'
        endif
      endif

      assign cat_colors = bundle_product.metafields.shopify['color-pattern'].value | default: bundle_product.metafields.custom.color.value
      assign default_bundle_color = 'Dark Brown'
      if cat_colors != blank
        for item in cat_colors
          if forloop.first
            assign default_bundle_color = item.label | default: item.name | default: item.value | default: item | strip
          endif
        endfor
      endif
    -%}

    <!-- Bundles Grid / Cards Row -->
    <div class="bundle-cards-row">
      <!-- Bundle Card 1: 1 Bottle -->
      <div class="bundle-item-card bundle-card-1">
        <div class="bundle-card-top">
          <div class="bundle-img-box">
