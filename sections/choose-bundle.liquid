  <script>
    (function () {
      function initBundleCart() {
        var section =
          document.getElementById('bundleOfferSection') ||
          document.getElementById('chooseBundle') ||
          document.querySelector('.bundle-offer-section');
        if (!section) return;

        var bundleButtons = section.querySelectorAll('.bundle-btn');
        bundleButtons.forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            var variantId = btn.getAttribute('data-variant-id');
            var qty = parseInt(btn.getAttribute('data-bundle-qty') || '1', 10);
            if (!variantId) return;

            var btnSpan = btn.querySelector('span');
            var originalText = btnSpan ? btnSpan.textContent : btn.textContent;
            btn.disabled = true;
            if (btnSpan) btnSpan.textContent = 'ADDING...';

            var cartDrawer =
              document.querySelector('cart-drawer') ||
              document.querySelector('#CartDrawer') ||
              document.querySelector('cart-notification');
            var sectionsToRender = [];
            if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
              sectionsToRender = cartDrawer.getSectionsToRender().map(function (s) {
                return s.section || s.id;
              });
            } else {
              sectionsToRender = ['cart-drawer', 'cart-icon-bubble'];
            }

            var formData = new FormData();
            formData.append('id', variantId);
            formData.append('quantity', qty);
            if (sectionsToRender.length > 0) {
              formData.append('sections', sectionsToRender.join(','));
              formData.append('sections_url', window.location.pathname);
            }

            var addUrl = window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add';

            fetch(addUrl, {
              method: 'POST',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                Accept: 'application/javascript',
              },
              body: formData,
            })
              .then(function (res) {
                return res.json();
              })
              .then(function (data) {
                if (data.status && data.message) {
                  alert(data.message + (data.description ? ': ' + data.description : ''));
                  return;
                }

                if (typeof window.openShopifyCartDrawer === 'function') {
                  window.openShopifyCartDrawer(data, btn);
                } else {
                  if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
                    cartDrawer.renderContents(data);
                  } else if (cartDrawer && typeof cartDrawer.open === 'function') {
                    cartDrawer.open(btn);
                  } else if (cartDrawer && cartDrawer.classList) {
                    cartDrawer.classList.add('animate', 'active');
                    document.body.classList.add('overflow-hidden');
                  } else {
                    var bubble = document.querySelector('#cart-icon-bubble');
                    if (bubble) bubble.click();
                  }
                }
              })
              .catch(function (err) {
                console.error('Bundle add to cart error:', err);
              })
              .finally(function () {
                btn.disabled = false;
                if (btnSpan) btnSpan.textContent = originalText;
              });
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBundleCart);
      } else {
        initBundleCart();
      }

      document.addEventListener('shopify:section:load', function (e) {
        if (
          e.target &&
          (e.target.querySelector('#bundleOfferSection') ||
            e.target.querySelector('#chooseBundle') ||
            e.target.querySelector('.bundle-offer-section'))
        ) {
          initBundleCart();
        }
      });
    })();
  </script>

