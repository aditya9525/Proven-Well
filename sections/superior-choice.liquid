 {% endcomment %}



 {%- comment -%}
  Shopify Section: 06 — The Superior Choice (Comparison Section)
  Desktop: Side-by-side comparison cards (Polar vs Regular Hair Dye) with center floating category labels card.
  Mobile: Integrated 3-column comparison table card with Polar dark column and Regular light column.
  Supports dynamic rows via blocks ("Comparison Row") and customizable logos/images for both columns.
{%- endcomment -%}

{%- if section.settings.enable_section -%}
  {%- liquid
    assign has_blocks = false
    if section.blocks.size > 0
      assign has_blocks = true
    endif
  -%}

  <section class="superior-choice-section" id="superiorChoice" aria-labelledby="superiorHeading">
    <div class="superior-choice-container">

      <!-- Section Header (Desktop & Mobile) -->
      <div class="superior-header">
        <span class="superior-eyebrow">{{ section.settings.eyebrow | default: "THE SUPERIOR CHOICE" }}</span>
        <h2 class="superior-main-title-desktop" id="superiorHeading">
          {{ section.settings.heading | default: "The Superior Choice" }}
        </h2>
        <h2 class="superior-main-title-mobile">
          {{ section.settings.mobile_heading | default: "Polar vs. regular hair dye" }}
        </h2>
        <p class="superior-sub-desc-desktop">
          {{ section.settings.description | default: "It’s been over a 100 years since the first dyes were created, but we haven't seen any sort of significant change since then. Polar Haircare is here to change that." }}
        </p>
        <p class="superior-sub-desc-mobile">
          {{ section.settings.mobile_description | default: "It’s been over 100 years since the first dyes were created, with no significant change. Until now." }}
        </p>
      </div>

      <!-- DESKTOP COMPARISON WRAPPER (> 768px) -->
      <div class="superior-comparison-wrap superior-comparison-desktop">
        
        <!-- Left Card: Polar Hair Care (Winner) -->
        <div class="superior-card superior-card-polar">
          
          <!-- Brand Logo / Header -->
          <div class="superior-card-brand">
            {%- if section.settings.polar_logo != blank -%}
              <img
                src="{{ section.settings.polar_logo | image_url: width: 400 }}"
                alt="{{ section.settings.polar_logo.alt | default: 'Polar Hair Care' | escape }}"
                class="superior-brand-img"
                style="max-width: {{ section.settings.polar_logo_width | default: 216 }}px;"
                loading="lazy"
              >
            {%- else -%}
              <div class="superior-polar-logo-text">
                <span class="polar-logo-main">{{ section.settings.polar_logo_text_main | default: "POLAR<sup>®</sup>" }}</span>
                <span class="polar-logo-sub">{{ section.settings.polar_logo_text_sub | default: "HAIR CARE" }}</span>
              </div>
            {%- endif -%}
          </div>

          <!-- Product Image -->
          <div class="superior-product-img-wrap">
            {%- if section.settings.polar_image != blank -%}
              <img src="{{ section.settings.polar_image | image_url: width: 400 }}" alt="Polar Hair Care Instant Dye Shampoo" class="superior-product-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'polar-bottle-tall.png' | asset_url }}" alt="Polar Hair Care Instant Dye Shampoo" class="superior-product-img" loading="lazy">
            {%- endif -%}
          </div>

          <!-- Polar Rows List -->
          <div class="superior-rows-list superior-rows-left">
            {%- if has_blocks -%}
              {%- for block in section.blocks -%}
                <div class="superior-row-pill superior-pill-polar" {{ block.shopify_attributes }}>
                  {%- if block.settings.polar_icon == 'cross' -%}
                    <div class="superior-badge-icon superior-badge-cross" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </div>
                  {%- elsif block.settings.polar_icon != 'none' -%}
                    <div class="superior-badge-icon superior-badge-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                  {%- endif -%}
                  <span class="superior-row-val">{{ block.settings.polar_val }}</span>
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback Default Rows -->
              <div class="superior-row-pill superior-pill-polar">
                <div class="superior-badge-icon superior-badge-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span class="superior-row-val">{{ section.settings.polar_val_1 | default: "15 applications" }}</span>
              </div>
              <div class="superior-row-pill superior-pill-polar">
                <div class="superior-badge-icon superior-badge-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span class="superior-row-val">{{ section.settings.polar_val_2 | default: "10 minutes" }}</span>
              </div>
              <div class="superior-row-pill superior-pill-polar">
                <div class="superior-badge-icon superior-badge-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span class="superior-row-val">{{ section.settings.polar_val_3 | default: "$2.33" }}</span>
              </div>
              <div class="superior-row-pill superior-pill-polar">
                <div class="superior-badge-icon superior-badge-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span class="superior-row-val">{{ section.settings.polar_val_4 | default: "Ammonia-free" }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Center Floating Category Labels Card (Desktop) -->
        <div class="superior-center-labels-card" aria-hidden="true">
          {%- if has_blocks -%}
            {%- for block in section.blocks -%}
              <div class="superior-cat-label-item" {{ block.shopify_attributes }}>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Default Category Labels -->
            <div class="superior-cat-label-item">
              <span>{{ section.settings.label_1 | default: "NUMBER OF USES" }}</span>
            </div>
            <div class="superior-cat-label-item">
              <span>{{ section.settings.label_2 | default: "APPLICATION TIME" }}</span>
            </div>
            <div class="superior-cat-label-item">
              <span>{{ section.settings.label_3 | default: "COST PER USE" }}</span>
            </div>
            <div class="superior-cat-label-item">
              <span>{{ section.settings.label_4 | default: "INGREDIENTS" }}</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Right Card: Regular Hair Dye (Loser) -->
        <div class="superior-card superior-card-regular">
          
          <!-- Header Title / Logo -->
          <div class="superior-card-brand">
            {%- if section.settings.regular_logo != blank -%}
              <img
                src="{{ section.settings.regular_logo | image_url: width: 400 }}"
                alt="{{ section.settings.regular_title | default: 'Regular Hair Dye' | escape }}"
                class="superior-brand-img superior-regular-brand-img"
                style="max-width: {{ section.settings.regular_logo_width | default: 216 }}px;"
                loading="lazy"
              >
            {%- else -%}
              <h3 class="superior-regular-title">{{ section.settings.regular_title | default: "Regular Hair Dye" }}</h3>
            {%- endif -%}
          </div>

          <!-- Product Image / Illustration -->
          <div class="superior-product-img-wrap superior-regular-img-wrap">
            {%- if section.settings.regular_image != blank -%}
              <img src="{{ section.settings.regular_image | image_url: width: 400 }}" alt="{{ section.settings.regular_title | default: 'Regular Hair Dye' | escape }}" class="superior-product-img superior-bowl-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'dye-bowl.png' | asset_url }}" alt="{{ section.settings.regular_title | default: 'Regular Hair Dye' | escape }}" class="superior-product-img superior-bowl-img" loading="lazy">
            {%- endif -%}
          </div>

          <!-- Regular Rows List -->
          <div class="superior-rows-list superior-rows-right">
            {%- if has_blocks -%}
              {%- for block in section.blocks -%}
                <div class="superior-row-pill superior-pill-regular" {{ block.shopify_attributes }}>
                  <span class="superior-row-val">{{ block.settings.regular_val }}</span>
                  {%- if block.settings.regular_icon == 'check' -%}
                    <div class="superior-badge-icon superior-badge-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                  {%- elsif block.settings.regular_icon != 'none' -%}
                    <div class="superior-badge-icon superior-badge-cross" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback Default Regular Rows -->
              <div class="superior-row-pill superior-pill-regular">
                <span class="superior-row-val">{{ section.settings.regular_val_1 | default: "1 application" }}</span>
                <div class="superior-badge-icon superior-badge-cross" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </div>
              </div>
              <div class="superior-row-pill superior-pill-regular">
                <span class="superior-row-val">{{ section.settings.regular_val_2 | default: "40-60 minutes" }}</span>
                <div class="superior-badge-icon superior-badge-cross" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </div>
              </div>
              <div class="superior-row-pill superior-pill-regular">
                <span class="superior-row-val">{{ section.settings.regular_val_3 | default: "$15" }}</span>
                <div class="superior-badge-icon superior-badge-cross" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </div>
              </div>
              <div class="superior-row-pill superior-pill-regular">
                <span class="superior-row-val">{{ section.settings.regular_val_4 | default: "Synthetic" }}</span>
                <div class="superior-badge-icon superior-badge-cross" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </div>
              </div>
            {%- endif -%}
          </div>

        </div>

      </div>

      <!-- MOBILE COMPARISON TABLE (<= 768px) -->
      <div class="superior-comparison-mobile">
        <div class="superior-mobile-table">

          <!-- Header Row (3 Columns) -->
          <div class="superior-mob-row superior-mob-header-row">
            <div class="superior-mob-col-blank"></div>
            
            <!-- Polar Mobile Column Header -->
            <div class="superior-mob-col-polar superior-mob-head-polar">
              {%- if section.settings.polar_logo != blank -%}
                <img
                  src="{{ section.settings.polar_logo | image_url: width: 250 }}"
                  alt="{{ section.settings.polar_logo.alt | default: 'Polar Hair Care' | escape }}"
                  class="superior-mob-brand-img"
                  style="max-width: {{ section.settings.polar_logo_width_mobile | default: 90 }}px;"
                  loading="lazy"
                >
              {%- else -%}
                <div class="superior-mob-logo">
                  <span>{{ section.settings.polar_logo_text_main | default: "POLAR<sup>®</sup>" }}</span>
                  <small>{{ section.settings.polar_logo_text_sub | default: "HAIR CARE" }}</small>
                </div>
              {%- endif -%}

              {%- if section.settings.polar_image != blank -%}
                <img src="{{ section.settings.polar_image | image_url: width: 250 }}" alt="Polar Bottle" class="superior-mob-bottle-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'polar-bottle-tall.png' | asset_url }}" alt="Polar Bottle" class="superior-mob-bottle-img" loading="lazy">
              {%- endif -%}
            </div>

            <!-- Regular Mobile Column Header -->
            <div class="superior-mob-col-regular superior-mob-head-regular">
              {%- if section.settings.regular_logo != blank -%}
                <img
                  src="{{ section.settings.regular_logo | image_url: width: 250 }}"
                  alt="{{ section.settings.regular_title | default: 'Regular Hair Dye' | escape }}"
                  class="superior-mob-brand-img"
                  style="max-width: {{ section.settings.regular_logo_width_mobile | default: 90 }}px;"
                  loading="lazy"
                >
              {%- else -%}
                <span class="superior-mob-reg-title">{{ section.settings.regular_title | default: "Regular Hair Dye" }}</span>
              {%- endif -%}

              {%- if section.settings.regular_image != blank -%}
                <img src="{{ section.settings.regular_image | image_url: width: 250 }}" alt="{{ section.settings.regular_title | default: 'Regular Dye' | escape }}" class="superior-mob-bowl-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'dye-bowl.png' | asset_url }}" alt="{{ section.settings.regular_title | default: 'Regular Dye' | escape }}" class="superior-mob-bowl-img" loading="lazy">
              {%- endif -%}
            </div>
          </div>

          <!-- Dynamic or Fallback Data Rows (Mobile) -->
          {%- if has_blocks -%}
            {%- for block in section.blocks -%}
              <div class="superior-mob-row superior-mob-data-row" {{ block.shopify_attributes }}>
                <div class="superior-mob-col-label">
                  <span>{{ block.settings.label }}</span>
                </div>
                <div class="superior-mob-col-polar">
                  {%- if block.settings.polar_icon == 'cross' -%}
                    <div class="superior-mob-badge-cross">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </div>
                  {%- elsif block.settings.polar_icon != 'none' -%}
                    <div class="superior-mob-badge-check">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                  {%- endif -%}
                  <span class="superior-mob-val-polar">{{ block.settings.polar_val }}</span>
                </div>
                <div class="superior-mob-col-regular">
                  {%- if block.settings.regular_icon == 'check' -%}
                    <div class="superior-mob-badge-check">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                  {%- elsif block.settings.regular_icon != 'none' -%}
                    <div class="superior-mob-badge-cross">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </div>
                  {%- endif -%}
                  <span class="superior-mob-val-reg">{{ block.settings.regular_val }}</span>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Default Mobile Rows -->
            <div class="superior-mob-row superior-mob-data-row">
              <div class="superior-mob-col-label">
                <span>{{ section.settings.label_1 | default: "NUMBER OF USES" }}</span>
              </div>
              <div class="superior-mob-col-polar">
                <div class="superior-mob-badge-check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="superior-mob-val-polar">{{ section.settings.polar_val_1 | default: "15 applications" }}</span>
              </div>
              <div class="superior-mob-col-regular">
                <div class="superior-mob-badge-cross">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </div>
                <span class="superior-mob-val-reg">{{ section.settings.regular_val_1 | default: "1 application" }}</span>
              </div>
            </div>

            <div class="superior-mob-row superior-mob-data-row">
              <div class="superior-mob-col-label">
                <span>{{ section.settings.label_2 | default: "APPLICATION TIME" }}</span>
              </div>
              <div class="superior-mob-col-polar">
                <div class="superior-mob-badge-check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="superior-mob-val-polar">{{ section.settings.polar_val_2 | default: "10 minutes" }}</span>
              </div>
              <div class="superior-mob-col-regular">
                <div class="superior-mob-badge-cross">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </div>
                <span class="superior-mob-val-reg">{{ section.settings.regular_val_2 | default: "40–60 minutes" }}</span>
              </div>
            </div>

            <div class="superior-mob-row superior-mob-data-row">
              <div class="superior-mob-col-label">
                <span>{{ section.settings.label_3 | default: "COST PER USE" }}</span>
              </div>
              <div class="superior-mob-col-polar">
                <div class="superior-mob-badge-check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="superior-mob-val-polar">{{ section.settings.polar_val_3 | default: "$2.33" }}</span>
              </div>
              <div class="superior-mob-col-regular">
                <div class="superior-mob-badge-cross">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </div>
                <span class="superior-mob-val-reg">{{ section.settings.regular_val_3 | default: "$15" }}</span>
              </div>
            </div>

            <div class="superior-mob-row superior-mob-data-row">
              <div class="superior-mob-col-label">
                <span>{{ section.settings.label_4 | default: "INGREDIENTS" }}</span>
              </div>
              <div class="superior-mob-col-polar">
                <div class="superior-mob-badge-check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="superior-mob-val-polar">{{ section.settings.polar_val_4 | default: "Ammonia-free" }}</span>
              </div>
              <div class="superior-mob-col-regular">
                <div class="superior-mob-badge-cross">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </div>
                <span class="superior-mob-val-reg">{{ section.settings.regular_val_4 | default: "Synthetic" }}</span>
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "06 — Superior Choice",
  "tag": "section",
  "class": "section-superior-choice",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE SUPERIOR CHOICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Desktop Heading",
      "default": "The Superior Choice"
    },
    {
      "type": "text",
      "id": "mobile_heading",
      "label": "Mobile Heading",
      "default": "Polar vs. regular hair dye"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Desktop Description",
      "default": "It’s been over a 100 years since the first dyes were created, but we haven't seen any sort of significant change since then. Polar Haircare is here to change that."
    },
    {
      "type": "textarea",
      "id": "mobile_description",
      "label": "Mobile Description",
      "default": "It’s been over 100 years since the first dyes were created, with no significant change. Until now."
    },
    {
      "type": "header",
      "content": "Polar (Left Column) Logo & Image"
    },
    {
      "type": "image_picker",
      "id": "polar_logo",
      "label": "Polar Logo Image (Optional)"
    },
    {
      "type": "range",
      "id": "polar_logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Polar Logo Desktop Width",
      "default": 220
    },
    {
      "type": "range",
      "id": "polar_logo_width_mobile",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Polar Logo Mobile Width",
      "default": 90
    },
    {
      "type": "text",
      "id": "polar_logo_text_main",
      "label": "Polar Logo Main Text (if no image)",
      "default": "POLAR<sup>®</sup>"
    },
    {
      "type": "text",
      "id": "polar_logo_text_sub",
      "label": "Polar Logo Sub Text (if no image)",
      "default": "HAIR CARE"
    },
    {
      "type": "image_picker",
      "id": "polar_image",
      "label": "Polar Product Image (Optional)"
    },
    {
      "type": "header",
      "content": "Regular / Competitor (Right Column) Logo & Image"
    },
    {
      "type": "image_picker",
      "id": "regular_logo",
      "label": "Regular / Competitor Logo Image (Optional)"
    },
    {
      "type": "range",
      "id": "regular_logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Regular Logo Desktop Width",
      "default": 220
    },
    {
      "type": "range",
      "id": "regular_logo_width_mobile",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Regular Logo Mobile Width",
      "default": 90
    },
    {
      "type": "text",
      "id": "regular_title",
      "label": "Regular Brand Title (if no image)",
      "default": "Regular Hair Dye"
    },
    {
      "type": "image_picker",
      "id": "regular_image",
      "label": "Regular Dye Image (Optional)"
    },
    {
      "type": "header",
      "content": "Default Fallback Comparison Rows (Legacy)"
    },
    {
      "type": "paragraph",
      "content": "Use the Blocks below to add, remove, and reorder as many comparison rows as you want! The settings below are only used as fallback if no blocks are added."
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Category 1",
      "default": "NUMBER OF USES"
    },
    {
      "type": "text",
      "id": "polar_val_1",
      "label": "Polar Feature 1",
      "default": "15 applications"
    },
    {
      "type": "text",
      "id": "regular_val_1",
      "label": "Regular Feature 1",
      "default": "1 application"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Category 2",
      "default": "APPLICATION TIME"
    },
    {
      "type": "text",
      "id": "polar_val_2",
      "label": "Polar Feature 2",
      "default": "10 minutes"
    },
    {
      "type": "text",
      "id": "regular_val_2",
      "label": "Regular Feature 2",
      "default": "40-60 minutes"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Category 3",
      "default": "COST PER USE"
    },
    {
      "type": "text",
      "id": "polar_val_3",
      "label": "Polar Feature 3",
      "default": "$2.33"
    },
    {
      "type": "text",
      "id": "regular_val_3",
      "label": "Regular Feature 3",
      "default": "$15"
    },
    {
      "type": "text",
      "id": "label_4",
      "label": "Category 4",
      "default": "INGREDIENTS"
    },
    {
      "type": "text",
      "id": "polar_val_4",
      "label": "Polar Feature 4",
      "default": "Ammonia-free"
    },
    {
      "type": "text",
      "id": "regular_val_4",
      "label": "Regular Feature 4",
      "default": "Synthetic"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row Feature / Category Label",
          "default": "FEATURE NAME"
        },
        {
          "type": "header",
          "content": "Polar (Left Column)"
        },
        {
          "type": "text",
          "id": "polar_val",
          "label": "Polar Value",
          "default": "15 applications"
        },
        {
          "type": "select",
          "id": "polar_icon",
          "label": "Polar Icon",
          "options": [
            {
              "value": "check",
              "label": "Green Checkmark"
            },
            {
              "value": "cross",
              "label": "Red Cross"
            },
            {
              "value": "none",
              "label": "No Icon"
            }
          ],
          "default": "check"
        },
        {
          "type": "header",
          "content": "Regular / Competitor (Right Column)"
        },
        {
          "type": "text",
          "id": "regular_val",
          "label": "Regular / Competitor Value",
          "default": "1 application"
        },
        {
          "type": "select",
          "id": "regular_icon",
          "label": "Regular / Competitor Icon",
          "options": [
            {
              "value": "cross",
              "label": "Red Cross"
            },
            {
              "value": "check",
              "label": "Green Checkmark"
            },
            {
              "value": "none",
              "label": "No Icon"
            }
          ],
          "default": "cross"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "06 — Superior Choice",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "NUMBER OF USES",
            "polar_val": "15 applications",
            "polar_icon": "check",
            "regular_val": "1 application",
            "regular_icon": "cross"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "APPLICATION TIME",
            "polar_val": "10 minutes",
            "polar_icon": "check",
            "regular_val": "40-60 minutes",
            "regular_icon": "cross"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "COST PER USE",
            "polar_val": "$2.33",
            "polar_icon": "check",
            "regular_val": "$15",
            "regular_icon": "cross"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "INGREDIENTS",
            "polar_val": "Ammonia-free",
            "polar_icon": "check",
            "regular_val": "Synthetic",
            "regular_icon": "cross"
          }
        }
      ]
    }
  ]
}
{% endschema %}
