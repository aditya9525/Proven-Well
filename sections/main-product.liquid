                        alt="Customer Video Review {{ forloop.index }}"
                        class="ugc-cover-img"
                        loading="lazy"
                      >
                    {%- endif -%}
                    {%- if final_video != blank -%}
                      <button class="ugc-play-btn" aria-label="Play Customer Video">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="#FFFFFF">
                          <polygon points="6 3 20 12 6 21 6 3"></polygon>
                        </svg>
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <!-- Carousel Controls -->
        <div class="ugc-nav-controls">
          <button class="ugc-arrow prev ugc-cust-prev" aria-label="Previous customer video">
            <svg width="10" height="16" viewBox="0 0 8 14" fill="none">
              <path d="M7 1L1 7L7 13" stroke="#5E3A58" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </button>
          <button class="ugc-arrow next ugc-cust-next" aria-label="Next customer video">
            <svg width="10" height="16" viewBox="0 0 8 14" fill="none">
              <path d="M1 1L7 7L1 13" stroke="#5E3A58" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Accordions -->
      <div class="product-accordions-group">
        <div class="accordion-item active">
          <button class="accordion-header" type="button">
            <span class="accordion-title">Description</span>
            <svg class="accordion-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-panel">
            <p>
              {{
                product.description
                | default: 'Experience salon-grade gray coverage from the comfort of your own shower. Polar Hair Care Instant Dye Shampoo naturally covers stubborn gray hairs in under 10 minutes.'
              }}
            </p>
          </div>
        </div>
        <div class="accordion-item">
          <button class="accordion-header" type="button">
            <span class="accordion-title">Ingredients</span>
            <svg class="accordion-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-panel">
            <p>
              Aqua (Water), Argan Oil, Polygonum Multiflorum Extract, Ginseng Extract, Keratin, Ammonia-Free Plant Dye
              Actives, Glycerin, Fragrance.
            </p>
          </div>
        </div>
        <div class="accordion-item">
          <button class="accordion-header" type="button">
            <span class="accordion-title">Shipping & delivery</span>
            <svg class="accordion-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-panel">
            <p>Dispatched within 24-48 hours. Free expedited shipping on 2+ bottles.</p>
          </div>
        </div>
        <div class="accordion-item">
          <button class="accordion-header" type="button">
            <span class="accordion-title">Price breakdown</span>
            <svg class="accordion-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-panel"><p>Up to 15 full uses per bottle = as low as $2.33 / Rs. 195 per use.</p></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-header" type="button">
            <span class="accordion-title">How To Use</span>
            <svg class="accordion-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="accordion-panel">
            <p>1. Put on gloves. 2. Pump into damp hair. 3. Massage 3-5 mins. 4. Wait 10 mins. 5. Rinse until clear.</p>
          </div>
        </div>
        {%- if product.metafields.shopify['application-type'] != blank
          or product.metafields.shopify['hair-color-formulation'] != blank
          or product.metafields.shopify['product-form'] != blank
          or product.metafields.shopify.material != blank
          or product.metafields.shopify.application_type != blank
          or product.metafields.shopify.hair_color_formulation != blank
          or product.metafields.shopify.product_form != blank
        -%}
          <div class="accordion-item">
            <button class="accordion-header" type="button">
              <span class="accordion-title">Product Specifications</span>
              <svg class="accordion-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none">
                <path d="M1 1.5L6 6.5L11 1.5" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="accordion-panel">
              <div class="metafield-specs-grid">
                {%- if product.metafields.shopify['application-type'] != blank
                  or product.metafields.shopify.application_type != blank
                -%}
                  <div class="spec-item">
                    <span class="spec-label">Application Type</span
                    ><strong class="spec-val">
                      {{-
                        product.metafields.shopify['application-type'].value
                        | default: product.metafields.shopify.application_type.value
                        | default: product.metafields.shopify['application-type']
                      -}}
                    </strong>
                  </div>
                {%- endif -%}
                {%- if product.metafields.shopify['hair-color-formulation'] != blank
                  or product.metafields.shopify.hair_color_formulation != blank
                -%}
                  <div class="spec-item">
                    <span class="spec-label">Hair Color Formulation</span
                    ><strong class="spec-val">
                      {{-
                        product.metafields.shopify['hair-color-formulation'].value
                        | default: product.metafields.shopify.hair_color_formulation.value
                        | default: product.metafields.shopify['hair-color-formulation']
                      -}}
                    </strong>
                  </div>
                {%- endif -%}
                {%- if product.metafields.shopify['product-form'] != blank
                  or product.metafields.shopify.product_form != blank
                -%}
                  <div class="spec-item">
                    <span class="spec-label">Product Form</span
                    ><strong class="spec-val">
                      {{-
                        product.metafields.shopify['product-form'].value
                        | default: product.metafields.shopify.product_form.value
                        | default: product.metafields.shopify['product-form']
                      -}}
                    </strong>
                  </div>
                {%- endif -%}
                {%- if product.metafields.shopify.material != blank -%}
                  <div class="spec-item">
                    <span class="spec-label">Material</span
                    ><strong class="spec-val">
                      {{- product.metafields.shopify.material.value | default: product.metafields.shopify.material -}}
                    </strong>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initMainProduct() {
      var section = document.getElementById('productSection');
      if (!section) return;

      // 1. Accordion Toggle
      var accordionHeaders = section.querySelectorAll('.accordion-header');
      accordionHeaders.forEach(function (header) {
        header.addEventListener('click', function (e) {
          e.preventDefault();
          var item = header.closest('.accordion-item');
          if (item) {
            item.classList.toggle('active');
          }
        });
      });

      // 2. Product Main Image Swiper Carousel & Thumbnails Sync
      var productSwiperInstance = null;

      function initProductGallerySwiper() {
        var gallerySwiperEl = section.querySelector('#mainProductSwiper');
        if (!gallerySwiperEl || typeof Swiper === 'undefined') return;

        var thumbBtns = section.querySelectorAll('.thumb-item');
        var galleryCurrentIndex = section.querySelector('#galleryCurrentIndex');
        var galleryTotalCount = section.querySelector('#galleryTotalCount');
        var prevBtn = section.querySelector('.thumb-nav-btn.prev');
        var nextBtn = section.querySelector('.thumb-nav-btn.next');

        if (galleryTotalCount && thumbBtns.length > 0) {
          galleryTotalCount.textContent = thumbBtns.length;
        }

        if (productSwiperInstance) {
          try {
            productSwiperInstance.destroy(true, true);
          } catch (err) {}
          productSwiperInstance = null;
        }

        function syncThumbnails(activeIndex) {
          if (galleryCurrentIndex) {
            galleryCurrentIndex.textContent = activeIndex + 1;
          }
          thumbBtns.forEach(function (thumb, i) {
            if (i === activeIndex) {
              thumb.classList.add('active');
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
              thumb.classList.remove('active');
            }
          });
        }

        productSwiperInstance = new Swiper(gallerySwiperEl, {
          slidesPerView: 1,
          spaceBetween: 0,
          speed: 350,
          grabCursor: true,
          rewind: true,
          watchOverflow: true,
          touchRatio: 1,
          threshold: 5,
          resistanceRatio: 0.85,
          on: {
            init: function () {
              syncThumbnails(this.activeIndex);
            },
            slideChange: function () {
              syncThumbnails(this.activeIndex);
            },
          },
        });

        // Prev Button click handler
        if (prevBtn) {
          prevBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (productSwiperInstance) {
              productSwiperInstance.slidePrev();
            }
          };
        }

        // Next Button click handler
        if (nextBtn) {
          nextBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (productSwiperInstance) {
              productSwiperInstance.slideNext();
            }
          };
        }

        // Thumbnail Items click handler
        thumbBtns.forEach(function (thumb, idx) {
          thumb.onclick = function (e) {
            e.preventDefault();
            if (productSwiperInstance) {
              productSwiperInstance.slideTo(idx);
            }
          };
        });
      }

      // 3. Color Swatches (Category Metafield)
      var colorSwatches = section.querySelectorAll('.color-swatch-btn');
      var selectedColorName = section.querySelector('#selectedColorName');
      var shadeBadgeText = section.querySelector('#shadeBadgeText');
      var selectedColorProperty = section.querySelector('#selectedColorProperty');

      colorSwatches.forEach(function (swatch) {
        swatch.addEventListener('click', function (e) {
          e.preventDefault();
          colorSwatches.forEach(function (s) {
            s.classList.remove('active');
          });
          swatch.classList.add('active');
          var color = swatch.getAttribute('data-color');
          if (selectedColorName && color) selectedColorName.textContent = color;
          if (shadeBadgeText && color) shadeBadgeText.textContent = 'NATURAL ' + color.toUpperCase();
          if (selectedColorProperty && color) selectedColorProperty.value = color;
        });
      });

      // 4. Bundle Quantity & Rewards Unlock (Variants)
      var bundleCards = section.querySelectorAll('.bundle-card');
      var currentPriceEl = section.querySelector('#currentPrice');
      var comparePriceEl = section.querySelector('#comparePrice');
      var discountPills = section.querySelectorAll('.discount-pill');
      var selectedVariantId = section.querySelector('#selectedVariantId');
      var selectedQuantityInput = section.querySelector('#selectedQuantityInput');
      var addToCartBtn = section.querySelector('#addToCartBtn');
      var rewardsStatusText = section.querySelector('#rewardsStatusText');
      var rewardsProgressFill = section.querySelector('#rewardsProgressFill');
      var rewardsHintText = section.querySelector('#rewardsHintText');
      var rewardShipping = section.querySelector('#rewardShipping');
      var rewardConditioner = section.querySelector('#rewardConditioner');
      var milestoneShipping = section.querySelector('#milestoneShipping');
      var milestoneConditioner = section.querySelector('#milestoneConditioner');

      function formatPrice(centsOrValue) {
        if (!centsOrValue) return '';
        var num = Number(centsOrValue);
        if (num > 10000) num = num / 100;
        return 'Rs. ' + Math.round(num).toLocaleString('en-IN') + '.00';
      }

      bundleCards.forEach(function (card) {
        card.addEventListener('click', function (e) {
          e.preventDefault();
          bundleCards.forEach(function (c) {
            c.classList.remove('active');
          });
          card.classList.add('active');

          var variantId = card.getAttribute('data-variant-id');
          var qty = parseInt(card.getAttribute('data-qty') || '1', 10);
          var price = card.getAttribute('data-price');
          var compare = card.getAttribute('data-compare');
          var save = card.getAttribute('data-save');
          var isAvailable = card.getAttribute('data-available') !== 'false';

          if (selectedVariantId && variantId) selectedVariantId.value = variantId;
          if (selectedQuantityInput) selectedQuantityInput.value = qty;
          if (currentPriceEl && price) currentPriceEl.textContent = formatPrice(price);
          if (comparePriceEl && compare) comparePriceEl.textContent = formatPrice(compare);
          if (discountPills.length > 0 && save) {
            discountPills.forEach(function (pill) {
              pill.textContent = 'FALL SALE | SAVE ' + save;
            });
          }

          if (addToCartBtn) {
            var btnSpan = addToCartBtn.querySelector('span') || addToCartBtn;
            if (!isAvailable) {
              btnSpan.textContent = 'SOLD OUT';
              addToCartBtn.disabled = true;
            } else {
              btnSpan.textContent = 'ADD TO CART';
              addToCartBtn.disabled = false;
            }
          }

          if (qty === 1) {
            if (rewardsStatusText) rewardsStatusText.textContent = '0 of 2 unlocked';
            if (rewardsProgressFill) rewardsProgressFill.style.width = '15%';
            if (rewardShipping) rewardShipping.classList.remove('unlocked');
            if (rewardConditioner) rewardConditioner.classList.remove('unlocked');
            if (milestoneShipping) milestoneShipping.classList.remove('unlocked');
            if (milestoneConditioner) milestoneConditioner.classList.remove('unlocked');
            if (rewardsHintText) rewardsHintText.textContent = 'Add 1 more bottle to unlock free shipping';
          } else if (qty === 2) {
            if (rewardsStatusText) rewardsStatusText.textContent = '1 of 2 unlocked';
            if (rewardsProgressFill) rewardsProgressFill.style.width = '55%';
            if (rewardShipping) rewardShipping.classList.add('unlocked');
            if (rewardConditioner) rewardConditioner.classList.remove('unlocked');
            if (milestoneShipping) milestoneShipping.classList.add('unlocked');
            if (milestoneConditioner) milestoneConditioner.classList.remove('unlocked');
            if (rewardsHintText) rewardsHintText.textContent = 'Add 1 more bottle to unlock free conditioner';
          } else if (qty >= 3) {
            if (rewardsStatusText) rewardsStatusText.textContent = '2 of 2 unlocked 🎉';
            if (rewardsProgressFill) rewardsProgressFill.style.width = '100%';
            if (rewardShipping) rewardShipping.classList.add('unlocked');
            if (rewardConditioner) rewardConditioner.classList.add('unlocked');
            if (milestoneShipping) milestoneShipping.classList.add('unlocked');
            if (milestoneConditioner) milestoneConditioner.classList.add('unlocked');
            if (rewardsHintText)
              rewardsHintText.textContent = 'All rewards unlocked! You qualify for Free Shipping & Conditioner!';
          }
        });
      });

      async function refreshCartDrawer() {
        try {
          // Section Rendering API: current page ke saath cart-drawer ka HTML maango
          var res = await fetch(window.location.pathname + '?sections=cart-drawer');
          var json = await res.json();
          var html = json['cart-drawer'];
          if (!html) return;

          var doc = new DOMParser().parseFromString(html, 'text/html');
          var newDrawer = doc.querySelector('#cart-drawer');
          var oldDrawer = document.querySelector('#cart-drawer');

          if (newDrawer && oldDrawer) {
            // Sirf inner content swap, taaki drawer ka open/close logic na toote
            oldDrawer.innerHTML = newDrawer.innerHTML;
          }
        } catch (err) {
          console.warn('Cart drawer refresh failed:', err);
        }
      }

      var productForm = section.querySelector('#product-form');

      if (productForm) {
        productForm.addEventListener('submit', async function (e) {
          e.preventDefault();

          if (!selectedVariantId || !selectedVariantId.value) return;

          if (addToCartBtn) addToCartBtn.disabled = true;

          try {
            var formData = new FormData(productForm);

            var response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
              },
              body: formData,
            });

            var data = await response.json();

            if (!response.ok) {
              throw new Error(data.description || 'Unable to add product');
            }

            var cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
            var cart = await cartResponse.json();

            // 1. Drawer ka fresh HTML fetch karke swap karo
            await refreshCartDrawer();

            // 2. Theme ke baaki listeners (cart count bubble etc.) ko notify karo
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: { data: { itemCount: cart.item_count, source: 'product-form-component' } },
              })
            );

            // 3. Ab drawer open karo (sirf ek baar)
            var drawer = document.querySelector('#cart-drawer');
            if (drawer && typeof drawer.open === 'function') {
              drawer.open();
            } else if (drawer && typeof drawer.show === 'function') {
              drawer.show();
            } else {
              console.warn('Cart added, but drawer opener was not found.');
            }
          } catch (error) {
            console.error('Add to cart failed:', error);
            alert(error.message || 'Something went wrong.');
          } finally {
            if (addToCartBtn) addToCartBtn.disabled = false;
          }
        });
      }

      // UGC video play (ek time pe sirf ek video, pause pe thumbnail wapas)
      var ugcCards = section.querySelectorAll('.ugc-video-card');

      function resetUgcCard(card) {
        var video = card.querySelector('video.ugc-inline-video');
        var btn = card.querySelector('.ugc-play-btn');
        var thumb = card._thumbEl;
        if (video) {
          video.pause();
          video.replaceWith(thumb);
        }
        if (btn) btn.style.display = '';
      }

      ugcCards.forEach(function (card) {
        var btn = card.querySelector('.ugc-play-btn');
        var src = card.getAttribute('data-video');
        var thumb = card.querySelector('.ugc-cover-img');
        if (!btn || !src || !thumb) return;

        card._thumbEl = thumb; // original thumbnail save

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();

          // baaki sab cards reset (pause + thumbnail)
          ugcCards.forEach(function (other) {
            if (other !== card) resetUgcCard(other);
          });

          var video = document.createElement('video');
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          video.setAttribute('playsinline', '');
          video.className = 'ugc-cover-img ugc-inline-video';
          video.style.cssText = 'width:100%;height:100%;object-fit:cover;';

          // pause ya end pe thumbnail wapas
          video.addEventListener('pause', function () {
            if (!video.ended && video.seeking) return; // seek ke time pause ignore
            resetUgcCard(card);
          });
          video.addEventListener('ended', function () {
            resetUgcCard(card);
          });

          thumb.replaceWith(video);
          btn.style.display = 'none';
          video.play().catch(function () {});
        });
      });

      // 5. UGC Video Carousel Swiper
      function initUgcSwiper() {
        var ugcCustomersSwiperEl = section.querySelector('#ugcCustomersSwiper');
        if (!ugcCustomersSwiperEl) return;
        if (typeof Swiper !== 'undefined') {
          new Swiper(ugcCustomersSwiperEl, {
            slidesPerView: 2.3,
            spaceBetween: 10,
            grabCursor: true,
            watchOverflow: true,
            navigation: {
              nextEl: section.querySelector('.ugc-customers-section .ugc-cust-next'),
              prevEl: section.querySelector('.ugc-customers-section .ugc-cust-prev'),
            },
            breakpoints: {
              769: {
                slidesPerView: 2.3,
                spaceBetween: 16,
              },
            },
          });
        }
      }

      function initAllSwipers() {
        initProductGallerySwiper();
        initUgcSwiper();
      }

      if (typeof Swiper === 'undefined') {
        var existingScript = document.querySelector('script[src*="swiper-bundle.min.js"]');
        if (existingScript) {
          existingScript.addEventListener('load', initAllSwipers);
        } else {
          var script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
          script.onload = initAllSwipers;
          document.head.appendChild(script);
        }
      } else {
        initAllSwipers();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMainProduct);
    } else {
      initMainProduct();
    }

    // Support Shopify Theme Customizer section reload
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector('#productSection')) {
        initMainProduct();
      }
    });
  })();
</script>
{% schema %}
{
  "name": "Main Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky gallery on desktop",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "ugc_video",
      "name": "Customer Video",
      "limit": 10,
      "settings": [
       {
          "type": "text",
          "id": "cdn_video_url",
          "label": "Video CDN link (direct .mp4)",
          "info": "Agar yahan link doge to ye Shopify video se pehle use hoga"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Customer video (Shopify-hosted mp4, fallback)"
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Cover image (optional)",
          "info": "Khali chhodo to video ka default preview use hoga"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Product",
      "blocks": [
        { "type": "ugc_video" },
        { "type": "ugc_video" },
        { "type": "ugc_video" }
      ]
    }
  ]
}
{% endschema %}