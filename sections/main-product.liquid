{{ 'style.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shopify Main Product Section
  Complete responsive product page with dynamic variant pricing, bundles, reward unlocks, spotlight reviews, trust badges, and accordions.
{%- endcomment -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<section class="product-section" id="productSection">
  <img
    class="top-line-style"
    src="{{ 'line_style.svg' | asset_url }}"
    alt=""
  >

  <img
    class="bottom-line-style"
    src="{{ 'line_style1.svg' | asset_url }}"
    alt=""
  >
  <div class="product-container">
    <!-- Left Column: Gallery & Spotlight -->
    <div class="product-left-col">
      <div class="product-gallery">
        <div class="main-image-wrapper">
          {% comment %}
            <div class="badge-per-use">
              <span>as low as</span>
              <strong>
                {%- assign lowest_var_price = product.variants.last.price | default: 233100 -%}
                {{ lowest_var_price | money_without_trailing_zeros }}
              </strong>
              <span>per use</span>
            </div>
          {% endcomment %}

          <!-- Product Main Images Swiper Carousel -->
          <div class="swiper main-product-swiper" id="mainProductSwiper">
            <div class="swiper-wrapper">
              {%- if product.media.size > 0 -%}
                {%- for media in product.media -%}
                  <div class="swiper-slide main-product-slide" data-index="{{ forloop.index }}">
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <div class="slide-video-container swiper-no-swiping">
                        {{
                          media
                          | video_tag:
                            controls: true,
                            autoplay: false,
                            playsinline: true,
                            muted: true,
                            class: 'main-product-img'
                        }}
                      </div>
                    {%- else -%}
                      <img
                        src="{{ media | image_url: width: 1000 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        class="main-product-img"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      >
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="swiper-slide main-product-slide" data-index="1">
                  <img
                    src="{{ 'product-black-main.png' | asset_url }}"
                    alt="Natural Black Bottle & Box"
                    class="main-product-img"
                    loading="eager"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="2">
                  <img
                    src="{{ 'polar-bottle-tall.png' | asset_url }}"
                    alt="Polar Tall Bottle"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="3">
                  <img
                    src="{{ 'spotlight-caroline.png' | asset_url }}"
                    alt="Before After Caroline"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="4">
                  <img
                    src="{{ 'customer_story.jpg' | asset_url }}"
                    alt="Video Review"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="5">
                  <img
                    src="{{ 'polar_shampoo.jpg' | asset_url }}"
                    alt="Packaging view"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="6">
                  <img
                    src="{{ 'before_after.jpg' | asset_url }}"
                    alt="Before After Results"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="7">
                  <img
                    src="{{ 'product-feature-callout.png' | asset_url }}"
                    alt="Features"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
                <div class="swiper-slide main-product-slide" data-index="8">
                  <img
                    src="{{ 'before-after-3.jpg' | asset_url }}"
                    alt="Hair Results"
                    class="main-product-img"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
            </div>
          </div>
          <div class="gallery-counter-badge">
            <span id="galleryCurrentIndex">1</span> /
            <span id="galleryTotalCount">
              {%- if product.media.size > 0 %}{{ product.media.size }}{% else %}8{% endif -%}
            </span>
          </div>
        </div>

        <!-- Thumbnails Slider -->
        <div class="thumbnails-container">
          <button class="thumb-nav-btn prev" type="button" aria-label="Previous image">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none">
              <path d="M7 1L1 7L7 13" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="thumbnails-slider" id="thumbnailsSlider">
            {%- for media in product.media -%}
              <button
                class="thumb-item{% if forloop.first %} active{% endif %}"
                data-img="{{ media | image_url: width: 800 }}"
                data-index="{{ forloop.index }}"
                type="button"
              >
                <img src="{{ media | image_url: width: 120 }}" alt="{{ media.alt | escape }}">
              </button>
            {%- else -%}
              <button
                class="thumb-item active"
                data-img="{{ 'product-black-main.png' | asset_url }}"
                data-index="1"
                type="button"
              >
                <img src="{{ 'product-black-main.png' | asset_url }}" alt="Natural Black Bottle & Box">
              </button>
              <button
                class="thumb-item"
                data-img="{{ 'polar-bottle-tall.png' | asset_url }}"
                data-index="2"
                type="button"
              >
                <img src="{{ 'polar-bottle-tall.png' | asset_url }}" alt="Polar Tall Bottle">
              </button>
              <button
                class="thumb-item"
                data-img="{{ 'spotlight-caroline.png' | asset_url }}"
                data-index="3"
                type="button"
              >
                <img src="{{ 'spotlight-caroline.png' | asset_url }}" alt="Before After Caroline">
              </button>
              <button
                class="thumb-item video-thumb"
                data-img="{{ 'customer_story.jpg' | asset_url }}"
                data-index="4"
                type="button"
              >
                <img src="{{ 'customer_story.jpg' | asset_url }}" alt="Video Review">
                <span class="thumb-play-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFFFFF">
                    <polygon points="6 3 20 12 6 21 6 3"></polygon>
                  </svg>
                </span>
              </button>
              <button class="thumb-item" data-img="{{ 'polar_shampoo.jpg' | asset_url }}" data-index="5" type="button">
                <img src="{{ 'polar_shampoo.jpg' | asset_url }}" alt="Packaging view">
              </button>
              <button class="thumb-item" data-img="{{ 'before_after.jpg' | asset_url }}" data-index="6" type="button">
                <img src="{{ 'before_after.jpg' | asset_url }}" alt="Before After Results">
              </button>
              <button
                class="thumb-item"
                data-img="{{ 'product-feature-callout.png' | asset_url }}"
                data-index="7"
                type="button"
              >
                <img src="{{ 'product-feature-callout.png' | asset_url }}" alt="Features">
              </button>
              <button class="thumb-item" data-img="{{ 'before-after-3.jpg' | asset_url }}" data-index="8" type="button">
                <img src="{{ 'before-after-3.jpg' | asset_url }}" alt="Hair Results">
              </button>
            {%- endfor -%}
          </div>
          <button class="thumb-nav-btn next" type="button" aria-label="Next image">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none">
              <path d="M1 1L7 7L1 13" stroke="#1E2123" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Spotlight Card -->
      <div class="spotlight-card">
        <div class="spotlight-media">
          <img src="{{ 'spotlight-caroline.png' | asset_url }}" alt="Before & After Caroline T." class="spotlight-img">
          <div class="split-badges">
            <span class="pill-badge before-pill">BEFORE</span>
            <span class="pill-badge after-pill">AFTER</span>
          </div>
        </div>
        <div class="spotlight-content">
          <div class="star-rating-row">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h3 class="spotlight-title">I FEEL LIKE MYSELF AGAIN</h3>
          <p class="spotlight-quote">
            &ldquo;I look and feel like my younger self again. It’s nice having color that looks natural and not fake or
            harsh.&rdquo;
          </p>
          <div class="spotlight-author-row">
            <span class="spotlight-author">Caroline T., Austin, TX</span>
            <div class="verified-buyer-pill">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>VERIFIED BUYER</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Product Details & Actions -->
    <div class="product-right-col">
      <div class="product-reviews-header">
        <div class="stars-gold">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <a href="#reviews" class="reviews-count-link"><strong>(26,966)</strong> <span>Verified Reviews</span></a>
      </div>

      <h1 class="product-main-title">{{ product.title | default: 'Instant Dye Shampoo' }}</h1>
      <h2 class="product-subtitle">THE EASIEST WAY TO COVER GRAYS NATURALLY</h2>

      <hr class="product-divider">
      <!-- Pricing Row -->
      <div class="product-pricing-row">
        {%- assign initial_variant = product.selected_or_first_available_variant -%}
        {%- assign initial_compare = initial_variant.compare_at_price
          | default: product.compare_at_price
          | default: 490000
        -%}
        {%- assign initial_price = initial_variant.price | default: product.price | default: 350100 -%}
        {%- assign initial_save = 29 -%}
        {%- if initial_compare > initial_price -%}
          {%- assign initial_save = initial_compare
            | minus: initial_price
            | times: 100.0
            | divided_by: initial_compare
            | round
          -%}
        {%- endif -%}
        <span class="compare-at-price" id="comparePrice">{{ initial_compare | money }}</span>
        <span class="current-price" id="currentPrice">{{ initial_price | money }}</span>
        <div class="discount-pill desktop-view" id="discountPill">FALL SALE | SAVE {{ initial_save }}%</div>
        <div class="discount-pill mobile-view">FALL SALE | SAVE {{ initial_save }}%</div>
      </div>

      <!-- 4-Benefit Feature Grid -->
      <div class="features-highlight-box">
        <div class="feature-item">
          <span class="feature-check-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#FFFFFF"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div class="feature-text"><span>Covers grays</span><strong>in just 10 minutes</strong></div>
        </div>
        <div class="feature-item">
          <span class="feature-check-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#FFFFFF"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div class="feature-text"><span>Protects hair with</span><strong>ammonia-free formula</strong></div>
        </div>
        <div class="feature-item">
          <span class="feature-check-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#FFFFFF"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div class="feature-text"><span>As easy as</span><strong>regular shampoo</strong></div>
        </div>
        <div class="feature-item">
          <span class="feature-check-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#FFFFFF"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div class="feature-text"><span>Suitable for</span><strong>ALL hair types</strong></div>
        </div>
      </div>

      {%- liquid
        assign cat_colors = product.metafields.shopify['color-pattern'].value
        if cat_colors == blank
          assign cat_colors = product.metafields.shopify.color.value
        endif
        if cat_colors == blank
          assign cat_colors = product.metafields.shopify.color.value
        endif
        if cat_colors == blank
          assign cat_colors = product.metafields.shopify['hair-color'].value
        endif
        if cat_colors == blank
          assign cat_colors = product.metafields.shopify.hair_color.value
        endif
        if cat_colors == blank
          assign cat_colors = product.metafields.custom.color.value
        endif
        if cat_colors == blank
          assign cat_colors = product.metafields.custom.colors.value
        endif
        if cat_colors == blank and product.metafields.shopify['color-pattern'] != blank
          assign cat_colors = product.metafields.shopify['color-pattern']
        endif
        if cat_colors == blank and product.metafields.shopify.color != blank
          assign cat_colors = product.metafields.shopify.color
        endif

        assign default_first_color = 'Dark Brown'
        if cat_colors != blank
          for item in cat_colors
            if forloop.first
              assign default_first_color = item.label | default: item.name | default: item.value | default: item | strip
            endif
          endfor
        endif
      -%}

      <!-- Color Swatches (Dynamic Category Metafield) -->
      <div class="color-selection-wrapper">
        <div class="section-label-row">
          <span class="label-title">Choose Color:</span>
          <strong class="selected-color-name" id="selectedColorName">{{ default_first_color }}</strong>
        </div>
        <div class="color-swatches-list">
          {%- if cat_colors != blank -%}
            {%- for item in cat_colors -%}
              {%- liquid
                assign c_name = item.label | default: item.name | default: item.value | default: item | strip
                assign c_handle = c_name | handleize
                assign c_hex = item.color | default: item.hex | default: ''
                assign c_image = item.image
              -%}
              <button
                type="button"
                class="color-swatch-btn{% if forloop.first %} active{% endif %}"
                data-color="{{ c_name | escape }}"
              >
                <div class="swatch-img-box">
                  {%- if c_image != blank -%}
                    <img src="{{ c_image | image_url: width: 60 }}" alt="{{ c_name | escape }}" class="swatch-img">
                  {%- elsif c_handle contains 'dark-brown' or c_handle contains 'dark' -%}
                    <img src="{{ 'swatch-dark-brown.png' | asset_url }}" alt="{{ c_name | escape }}" class="swatch-img">
                  {%- elsif c_handle contains 'medium-brown' or c_handle contains 'medium' -%}
                    <img
                      src="{{ 'swatch-medium-brown.png' | asset_url }}"
                      alt="{{ c_name | escape }}"
                      class="swatch-img"
                    >
                  {%- elsif c_handle contains 'black' -%}
                    <img src="{{ 'swatch-black.png' | asset_url }}" alt="{{ c_name | escape }}" class="swatch-img">
                  {%- elsif c_hex != blank -%}
                    <span class="swatch-hex-circle" style="background-color: {{ c_hex }};"></span>
                  {%- else -%}
                    <span class="swatch-hex-circle swatch-fallback-{{ c_handle }}"></span>
                  {%- endif -%}
                </div>
                <span class="swatch-label">{{ c_name }}</span>
              </button>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Category Swatches matching store configuration -->
            <button type="button" class="color-swatch-btn active" data-color="Dark Brown">
              <div class="swatch-img-box">
                <img src="{{ 'swatch-dark-brown.png' | asset_url }}" alt="Dark Brown Swatch" class="swatch-img">
              </div>
              <span class="swatch-label">Dark Brown</span>
            </button>
            <button type="button" class="color-swatch-btn" data-color="Medium Brown">
              <div class="swatch-img-box">
                <img src="{{ 'swatch-medium-brown.png' | asset_url }}" alt="Medium Brown Swatch" class="swatch-img">
              </div>
              <span class="swatch-label">Medium Brown</span>
            </button>
            <button type="button" class="color-swatch-btn" data-color="Black">
              <div class="swatch-img-box">
                <img src="{{ 'swatch-black.png' | asset_url }}" alt="Black Swatch" class="swatch-img">
              </div>
              <span class="swatch-label">Black</span>
            </button>
          {%- endif -%}
        </div>
      </div>

      <!-- Bundle Selector (Dynamic Variants) -->
      <div class="quantity-bundles-wrapper">
        <div class="section-label-row"><span class="label-title">Select Quantity:</span></div>
        <div class="bundles-grid">
          {%- if product.variants.size > 0 and product.variants.first.title != 'Default Title' -%}
            {%- for variant in product.variants -%}
              {%- liquid
                assign qty = forloop.index
                if variant.title contains '1'
                  assign qty = 1
                elsif variant.title contains '2'
                  assign qty = 2
                elsif variant.title contains '3'
                  assign qty = 3
                endif

                assign var_price = variant.price
                assign var_compare = variant.compare_at_price
                if var_compare == blank or var_compare <= var_price
                  if qty == 1
                    assign var_compare = 490000
                  elsif qty == 2
                    assign var_compare = 980000
                  elsif qty == 3
                    assign var_compare = 1470000
                  else
                    assign var_compare = var_price | times: 1.4 | round
                  endif
                endif

                assign save_percent = 29
                if qty == 2
                  assign save_percent = 40
                elsif qty == 3
                  assign save_percent = 52
                elsif var_compare > var_price
                  assign save_percent = var_compare | minus: var_price | times: 100.0 | divided_by: var_compare | round
                endif
              -%}

              <div
                class="bundle-card{% if forloop.first %} active{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-qty="{{ qty }}"
                data-price="{{ var_price }}"
                data-compare="{{ var_compare }}"
                data-save="{{ save_percent }}%"
                data-available="{{ variant.available }}"
              >
                {%- if qty == 2 -%}
                  <div class="floating-benefit-badge shipping-badge">+ Free Shipping</div>
                {%- elsif qty >= 3 -%}
                  <div class="floating-benefit-badge conditioner-badge">+ Free Conditioner</div>
                {%- endif -%}

                <div class="bundle-box-btn">
                  <span class="bundle-qty-title">{{ variant.title }}</span>
                  <span class="bundle-perk-text">
                    {%- if qty == 2 -%}+ Free Shipping{%- elsif qty >= 3 -%}+ Free Conditioner{%- endif -%}
                  </span>
                </div>
                <span class="bundle-price-each">{{ var_price | money }} Each</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Static Bundles matching Shopify Variants -->
            <div
              class="bundle-card active"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-qty="1"
              data-price="350100"
              data-compare="490000"
              data-save="29%"
            >
              <div class="bundle-box-btn">
                <span class="bundle-qty-title">1 Bottle</span>
                <span class="bundle-perk-text"></span>
              </div>
              <span class="bundle-price-each">Rs. 3,501 Each</span>
            </div>
            <div
              class="bundle-card"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-qty="2"
              data-price="295100"
              data-compare="980000"
              data-save="40%"
            >
              <div class="floating-benefit-badge shipping-badge">+ Free Shipping</div>
              <div class="bundle-box-btn">
                <span class="bundle-qty-title">2 Bottles</span>
                <span class="bundle-perk-text">+ Free Shipping</span>
              </div>
              <span class="bundle-price-each">Rs. 2,951 Each</span>
            </div>
            <div
              class="bundle-card"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-qty="3"
              data-price="233100"
              data-compare="1470000"
              data-save="52%"
            >
              <div class="floating-benefit-badge conditioner-badge">+ Free Conditioner</div>
              <div class="bundle-box-btn">
                <span class="bundle-qty-title">3 Bottles</span>
                <span class="bundle-perk-text">+ Free Conditioner</span>
              </div>
              <span class="bundle-price-each">Rs. 2,331 Each</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Rewards Unlock Box -->
      <div class="rewards-unlock-card">
        <div class="rewards-header">
          <span class="rewards-title">Fall Sale Exclusive</span>
          <span class="rewards-unlocked-status" id="rewardsStatusText">0 of 2 unlocked</span>
        </div>
        <div class="rewards-body">
          <div class="rewards-progress-track">
            <div class="rewards-progress-fill" id="rewardsProgressFill" style="width: 15%;"></div>
          </div>
          <!-- Mobile Milestones Row -->
          <div class="rewards-milestones-row">
            <span class="milestone-item" id="milestoneShipping">&#10003; Free Shipping &middot; 2 Bottles</span>
            <span class="milestone-item" id="milestoneConditioner">Free Conditioner &middot; 3 Bottles</span>
          </div>
          <div class="rewards-items-grid">
            <div class="reward-item" id="rewardShipping">
              <div class="reward-icon-wrapper">
                <div class="lock-indicator">
                  <svg width="9" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                </div>
                <div class="reward-img-badge">
                  <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
