{%- comment -%}
  Shopify Sticky Header Section
  Fully responsive with fluid max-width, Shopify Navigation, Currency/Country selector, and Cart
{%- endcomment -%}
{{ 'style.css' | asset_url | stylesheet_tag }}
{% style %}
  :root {
    --bg-header: #FFFFFF;
    --border-header: #E5E7EB;
    --text-primary: #1E2123;
    --text-muted: #1E2123;
    --max-content-width: 1792px;
  }

  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 79px;
    background: {{ section.settings.bg_color | default: '#FFFFFF' }};
    border-bottom: 1px solid #E5E7EB;
    z-index: 1000;
    box-sizing: border-box;
    transition: box-shadow 0.25s ease;
  }

  .header-container {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1792px;
    height: 79px;
    margin: 0 auto;
    padding: 18px clamp(24px, calc((100% - 1200px) / 2), 296px);
    background: {{ section.settings.bg_color | default: '#FFFFFF' }};
  }

  /* provenwellLogo 1 */
  .header-logo-wrapper {
    width: 126px;
    height: 42px;
    display: flex;
    align-items: center;
    flex: none;
    order: 0;
    align-self: center;
    flex-grow: 0;
  }

  .header-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .brand-logo-img {
    width: 126px;
    height: 42px;
    object-fit: contain;
    display: block;
  }

  .brand-logo-provenwell {
    font-family: 'Times New Roman', Times, 'Playfair Display', Georgia, serif;
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
    line-height: 42px;
    letter-spacing: 1.5px;
    color: #1E2123;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }

  .brand-logo-reg {
    font-family: 'Lato', sans-serif;
    font-size: 9px;
    font-weight: 700;
    vertical-align: super;
    line-height: 1;
    margin-left: 2px;
    position: relative;
    top: -0.35em;
  }

  /* Navigation */
  .header-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0px;
    background: #FFFFFF;
    flex: none;
    order: 1;
    flex-grow: 0;
  }

  .nav-list {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0px;
    margin: 0px;
    gap: 36px;
    list-style: none;
    height: 18px;
    background: #FFFFFF;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    flex: none;
    flex-grow: 0;
  }

  .nav-link {
    font-family: 'Lato', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 15px;
    line-height: 18px;
    color: #1E2123;
    text-decoration: none;
    white-space: nowrap;
    padding: 0;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #4A2346;
  }

  .nav-link.active {
    color: #1E2123;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 0px;
    gap: 20px;
    width: 216px;
    height: 42px;
    background: #FFFFFF;
    flex: none;
    order: 2;
    flex-grow: 0;
  }

  /* India | INR ₹ */
  .localization-selector {
    display: flex;
    align-items: center;
    flex: none;
    order: 0;
    flex-grow: 0;
  }

  .localization-text {
    font-family: 'Lato', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 15px;
    line-height: 18px;
    color: #5E3A58;
    white-space: nowrap;
  }

  /* Button / Primary - Shop Now */
  .header-shop-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    width: 114px;
    height: 42px;
    background: #4A2346;
    border-radius: 8px;
    box-sizing: border-box;
    text-decoration: none;
    font-family: 'Lato', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 15px;
    line-height: 18px;
    color: #FFFFFF;
    white-space: nowrap;
    flex: none;
    order: 1;
    flex-grow: 0;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .header-shop-btn:hover {
    background: #3B1B37;
    transform: translateY(-1px);
  }

  .header-shop-btn:active {
    transform: translateY(0);
  }

  .header-cart-btn {
    display: none;
  }

  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-primary);
    cursor: pointer;
    border-radius: 4px;
  }

  .hamburger-icon {
    display: block;
    width: 24px;
    height: 24px;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: -280px;
    width: 280px;
    max-width: 85vw;
    height: 100vh;
    background: #FFFFFF;
    box-shadow: 2px 0 12px rgba(0, 0, 0, 0.15);
    z-index: 10000;
    padding: 24px;
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .mobile-drawer.open {
    transform: translateX(280px);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .mobile-drawer-title {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'Lato', sans-serif;
  }

  .mobile-drawer-close {
    background: transparent;
    border: none;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    color: var(--text-primary);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-link {
    font-size: 16px;
    color: #1E2123;
    text-decoration: none;
    display: block;
    padding: 6px 0;
    font-family: 'Lato', sans-serif;
  }

  .mobile-nav-link.active {
    color: #4A2346;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 1024px) {
    .header-nav {
      display: none;
    }
    .mobile-menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .site-header {
      background: #FFFFFF !important;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      height: 53px;
    }

    .header-container {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px;
      height: 53px;
      min-height: 53px;
      background: #FFFFFF;
      box-sizing: border-box;
      width: 100%;
      position: relative;
      gap: 0;
    }

    .mobile-menu-toggle {
      display: flex !important;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      padding: 0;
      margin: 0;
      background: transparent;
      border: none;
      cursor: pointer;
      order: 0;
      flex: none;
      z-index: 2;
    }

    .hamburger-icon {
      width: 24px;
      height: 24px;
      display: block;
    }

    .header-logo-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      order: 1;
      z-index: 1;
      width: auto;
      height: auto;
    }

    .header-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    .brand-logo-img {
      max-height: 24px;
      width: auto;
      display: block;
    }

    .brand-logo-provenwell {
      font-size: 16px;
      line-height: 24px;
    }

    .brand-logo-svg {
      width: 116px;
      height: 24px;
      max-height: 24px;
      display: block;
    }

    .header-actions {
      display: flex;
      align-items: center;
      order: 2;
      margin-left: auto;
      gap: 0;
      z-index: 2;
      width: auto;
      height: auto;
    }

    .localization-selector {
      display: none !important;
    }

    .header-shop-btn {
      display: none !important;
    }

    .header-cart-btn {
      display: flex !important;
      flex-direction: row;
      align-items: center;
      padding: 0;
      gap: 4px;
      height: 24px;
      position: static;
      text-decoration: none;
      background: transparent;
    }

    .cart-icon-wrapper {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: none;
    }

    .cart-icon-bag {
      width: 24px;
      height: 24px;
      display: block;
    }

    .cart-count {
      position: static !important;
      display: flex !important;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      padding: 0;
      width: 18px;
      height: 18px;
      min-width: 18px;
      background: #4A2346;
      border-radius: 9px;
      font-family: 'Lato', sans-serif;
      font-style: normal;
      font-weight: 700;
      font-size: 10px;
      line-height: 12px;
      color: #FFFFFF;
      flex: none;
      margin: 0;
    }
  }
{% endstyle %}

<header class="site-header" id="siteHeader">
  <div class="header-container">
    
    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-menu-toggle" aria-label="Toggle navigation menu" id="mobileMenuToggle">
      <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2" y="6" width="20" height="2" rx="1" fill="#1E2123"/>
        <rect x="2" y="11" width="14" height="2" rx="1" fill="#1E2123"/>
        <rect x="2" y="16" width="20" height="2" rx="1" fill="#1E2123"/>
      </svg>
    </button>

    <!-- Logo / Brand -->
    <div class="header-logo-wrapper">
      <a href="{{ routes.root_url }}" class="header-logo" aria-label="ProvenWell">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            loading="eager"
            class="brand-logo-img"
            width="126"
            height="42"
          >
        {%- else -%}
          <img
            src="{{ 'provenwellLogo.png' | asset_url }}"
            alt="ProvenWell"
            loading="eager"
            class="brand-logo-img"
            width="126"
            height="42"
            onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';"
          >
          <span class="brand-logo-provenwell" style="display: none;">PROVENWELL<sup class="brand-logo-reg">&reg;</sup></span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {%- if section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="nav-item">
              <a href="{{ link.url }}" class="nav-link{% if link.current or link.child_active %} active{% endif %}">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Default fallback links from Figma -->
          <li class="nav-item"><a href="{{ routes.root_url }}" class="nav-link">Home</a></li>
          <li class="nav-item"><a href="/products/instant-dye-shampoo" class="nav-link">Instant Dye Shampoo</a></li>
          <li class="nav-item"><a href="#results" class="nav-link">Results</a></li>
          <li class="nav-item"><a href="/pages/help-center" class="nav-link">Help Center</a></li>
          <li class="nav-item"><a href="/pages/track-order" class="nav-link">Track Your Order</a></li>
          <li class="nav-item"><a href="/pages/contact" class="nav-link">Contact Us</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Header Actions (Localization, Shop Now CTA & Mobile Cart) -->
    <div class="header-actions">
      
      <!-- Localization / Country & Currency Selector -->
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <div class="localization-selector">
          {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
            <span class="localization-text">{{ localization.country.name }} | {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</span>
          {%- endform -%}
        </div>
      {%- else -%}
        <div class="localization-selector">
          <span class="localization-text">India | INR &#8377;</span>
        </div>
      {%- endif -%}

      <!-- Shop Now Primary Button (Desktop) -->
      <a href="{{ section.settings.shop_now_link | default: '/products/instant-dye-shampoo' }}" class="header-shop-btn">
        {{ section.settings.shop_now_text | default: 'Shop Now' }}
      </a>

      <!-- Mobile Cart Icon Link -->
      <a href="{{ routes.cart_url }}" class="header-cart-btn" aria-label="Cart">
        <span class="cart-icon-wrapper">
          <svg class="cart-icon-bag" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.13 8C8.04 7.67 8 7.34 8 7C8 4.79 9.79 3 12 3C14.21 3 16 4.79 16 7C16 7.34 15.96 7.67 15.87 8" stroke="#1E2123" stroke-width="1.7"/>
            <rect x="4" y="8" width="16" height="13.5" rx="2.5" stroke="#1E2123" stroke-width="1.7"/>
          </svg>
        </span>
        <span class="cart-count">{% if cart.item_count > 0 %}{{ cart.item_count }}{% else %}0{% endif %}</span>
      </a>

    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer" id="mobileDrawer">
  <div class="mobile-drawer-header">
    <span class="mobile-drawer-title">Menu</span>
    <button class="mobile-drawer-close" id="mobileDrawerClose" aria-label="Close menu">&times;</button>
  </div>
  <ul class="mobile-nav-list">
    {%- if section.settings.menu != blank -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}" class="mobile-nav-link{% if link.current or link.child_active %} active{% endif %}">
            {{ link.title | escape }}
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      <li><a href="{{ routes.root_url }}" class="mobile-nav-link">Home</a></li>
      <li><a href="/products/instant-dye-shampoo" class="mobile-nav-link">Instant Dye Shampoo</a></li>
      <li><a href="#results" class="mobile-nav-link">Results</a></li>
      <li><a href="/pages/help-center" class="mobile-nav-link">Help Center</a></li>
      <li><a href="/pages/track-order" class="mobile-nav-link">Track Your Order</a></li>
      <li><a href="/pages/contact" class="mobile-nav-link">Contact Us</a></li>
    {%- endif -%}
  </ul>
</div>
<div class="drawer-overlay" id="drawerOverlay"></div>

<script>
  (function() {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const closeBtn = document.getElementById('mobileDrawerClose');

    function openNav() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeNav() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', openNav);
    closeBtn?.addEventListener('click', closeNav);
    overlay?.addEventListener('click', closeNav);

    // Open Shopify default cart drawer when clicking header cart icon
    var headerCartBtn = document.querySelector('.header-cart-btn');
    headerCartBtn?.addEventListener('click', function(e) {
      var cartDrawer = document.querySelector('cart-drawer') || document.querySelector('#CartDrawer') || document.querySelector('cart-notification');
      var nativeBubble = document.querySelector('#cart-icon-bubble');
      if (cartDrawer || nativeBubble) {
        e.preventDefault();
        if (typeof window.openShopifyCartDrawer === 'function') {
          window.openShopifyCartDrawer(null, headerCartBtn);
        } else if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open(headerCartBtn);
        } else if (cartDrawer && cartDrawer.classList) {
          cartDrawer.classList.add('animate', 'active');
          document.body.classList.add('overflow-hidden');
        } else if (nativeBubble) {
          nativeBubble.click();
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Custom logo width",
      "default": 130
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Shop Now Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "shop_now_link",
      "label": "Shop Now Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
